local function packValue(v)
	local t = typeof(v)
	if t == "number" or t == "string" or t == "boolean" then
		return v
	elseif t == "Vector2" then
		return { __t = "Vector2", X = v.X, Y = v.Y }
	elseif t == "Vector3" then
		return { __t = "Vector3", X = v.X, Y = v.Y, Z = v.Z }
	elseif t == "Color3" then
		return { __t = "Color3", R = v.R, G = v.G, B = v.B }
	elseif t == "CFrame" then
		return { __t = "CFrame", Values = { v:GetComponents() } }
	elseif t == "UDim" then
		return { __t = "UDim", Scale = v.Scale, Offset = v.Offset }
	elseif t == "UDim2" then
		return { __t = "UDim2", XS = v.X.Scale, XO = v.X.Offset, YS = v.Y.Scale, YO = v.Y.Offset }
	elseif t == "EnumItem" then
		return { __t = "EnumItem", Value = tostring(v) }
	elseif t == "NumberRange" then
		return { __t = "NumberRange", Min = v.Min, Max = v.Max }
	elseif t == "NumberSequence" then
		local keypoints = {}
		for i, kp in ipairs(v.Keypoints) do
			keypoints[i] = { Time = kp.Time, Value = kp.Value, Envelope = kp.Envelope }
		end
		return { __t = "NumberSequence", Keypoints = keypoints }
	elseif t == "ColorSequence" then
		local keypoints = {}
		for i, kp in ipairs(v.Keypoints) do
			keypoints[i] = { Time = kp.Time, Color = packValue(kp.Value) }
		end
		return { __t = "ColorSequence", Keypoints = keypoints }
	end
	return nil
end

local function unpackValue(v)
	if typeof(v) ~= "table" or not v.__t then
		return v
	end
	if v.__t == "Vector2" then
		return Vector2.new(v.X, v.Y)
	elseif v.__t == "Vector3" then
		return Vector3.new(v.X, v.Y, v.Z)
	elseif v.__t == "Color3" then
		return Color3.new(v.R, v.G, v.B)
	elseif v.__t == "CFrame" then
		return CFrame.new(table.unpack(v.Values))
	elseif v.__t == "UDim" then
		return UDim.new(v.Scale, v.Offset)
	elseif v.__t == "UDim2" then
		return UDim2.new(v.XS, v.XO, v.YS, v.YO)
	elseif v.__t == "EnumItem" then
		local enumName, itemName = tostring(v.Value):match("^Enum%.([^%.]+)%.(.+)$")
		if enumName and itemName then
			local ok, enumItem = pcall(function()
				return Enum[enumName][itemName]
			end)
			if ok then
				return enumItem
			end
		end
	elseif v.__t == "NumberRange" then
		return NumberRange.new(v.Min, v.Max)
	elseif v.__t == "NumberSequence" then
		local keypoints = {}
		for i, kp in ipairs(v.Keypoints or {}) do
			keypoints[i] = NumberSequenceKeypoint.new(kp.Time, kp.Value, kp.Envelope or 0)
		end
		return NumberSequence.new(keypoints)
	elseif v.__t == "ColorSequence" then
		local keypoints = {}
		for i, kp in ipairs(v.Keypoints or {}) do
			keypoints[i] = ColorSequenceKeypoint.new(kp.Time, unpackValue(kp.Color))
		end
		return ColorSequence.new(keypoints)
	end
	return nil
end

local function packedValuesEqual(a, b)
	if type(a) ~= type(b) then
		return false
	end
	if type(a) == "number" then
		return math.abs(a - b) <= 0.000001
	end
	if type(a) ~= "table" then
		return a == b
	end
	for k, v in pairs(a) do
		if not packedValuesEqual(v, b[k]) then
			return false
		end
	end
	for k in pairs(b) do
		if a[k] == nil then
			return false
		end
	end
	return true
end

local function appendProps(target, source)
	for _, prop in ipairs(source) do
		target[#target + 1] = prop
	end
end

