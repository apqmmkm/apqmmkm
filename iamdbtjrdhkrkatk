			obj[prop] = active
		end)
	end
end

function hideLiveObject(obj)
	if obj:IsDescendantOf(ReplayFolder) or obj.Name == "Terrain" or obj:IsA("Camera") then
		return
	end
	if hiddenStates[obj] then
		return
	end

	if obj:IsA("BasePart") then
		hiddenStates[obj] = {
			type = "BasePart",
			origTrans = obj.Transparency,
			origLocalTrans = obj.LocalTransparencyModifier,
		}
		obj.Transparency = 1
		obj.LocalTransparencyModifier = 1
	elseif obj:IsA("Decal") or obj:IsA("Texture") then
		hiddenStates[obj] = { type = "Texture", origState = getDecalTransparencyState(obj) }
		applyDecalTransparencyState(obj, { 1, 1 })
	elseif isReplayHiddenEffectObject(obj) then
		local prop, value = getReplayEffectActiveState(obj)
		if prop then
			hiddenStates[obj] = { type = "Effect", prop = prop, origValue = value }
			setReplayEffectActive(obj, false, prop)
		end
	elseif obj:IsA("Sound") then
		hiddenStates[obj] = { type = "Sound", origVol = obj.Volume }
		obj.Volume = 0
	end
end

function enforceLiveWorldHidden()
	for obj, data in pairs(hiddenStates) do
		if obj and obj.Parent then
			if data.type == "BasePart" then
				obj.LocalTransparencyModifier = 1
			elseif data.type == "Texture" then
				applyDecalTransparencyState(obj, { 1, 1 })
			elseif data.type == "Effect" then
				setReplayEffectActive(obj, false, data.prop)
			elseif data.type == "Sound" then
				obj.Volume = 0
			end
		else
			hiddenStates[obj] = nil
		end
	end
end

function hideLiveTree(root)
	if not root or root:IsDescendantOf(ReplayFolder) or root == workspace or root == SoundService then
		return
	end

	hideLiveObject(root)
	for _, obj in ipairs(root:GetDescendants()) do
		hideLiveObject(obj)
	end
end

function addSourceRoot(root, roots, seen)
	if not root or seen[root] or root:IsDescendantOf(ReplayFolder) or root == workspace or root == SoundService then
		return
	end

	local parent = root.Parent
	while parent do
		if seen[parent] then
			return
		end
		parent = parent.Parent
	end

	seen[root] = true
	roots[#roots + 1] = root
end

function collectReplaySourceRoots(session)
	local roots = {}
	local seen = {}

	if not session then
		return roots
	end

	for orig in pairs(session.RootClones or {}) do
		if typeof(orig) == "Instance" then
			addSourceRoot(orig, roots, seen)
		end
	end

	for _, entry in ipairs(sortedManifestEntries(session.Manifest)) do
		local data = entry.data
		if typeof(data) == "table" and not data.ParentId and not isLightingManifestData(data) then
			local source = findInstanceByPath(data.SourcePath)
			if source then
				addSourceRoot(source, roots, seen)
			end
		end
	end

	return roots
end

function hideLiveWorld()
	hiddenStates = {}

	for _, obj in pairs(workspace:GetDescendants()) do
		hideLiveObject(obj)
	end
	for _, obj in pairs(SoundService:GetDescendants()) do
		hideLiveObject(obj)
	end

	liveAddedConnection = workspace.DescendantAdded:Connect(hideLiveObject)
	liveSoundAddedConnection = SoundService.DescendantAdded:Connect(hideLiveObject)

	pcall(function()
		RunService:UnbindFromRenderStep("ReplayHideLive")
	end)
	local enforceAccumulator = 0
	liveEnforceConnection = RunService.Heartbeat:Connect(function(dt)
		enforceAccumulator += dt
		if enforceAccumulator >= LIVE_HIDE_ENFORCE_INTERVAL then
			enforceAccumulator = 0
			enforceLiveWorldHidden()
		end
	end)
end

function restoreLiveWorld()
	pcall(function()
		RunService:UnbindFromRenderStep("ReplayHideLive")
	end)
	if liveEnforceConnection then
		liveEnforceConnection:Disconnect()
		liveEnforceConnection = nil
	end
	if liveAddedConnection then
		liveAddedConnection:Disconnect()
		liveAddedConnection = nil
	end
	if liveSoundAddedConnection then
		liveSoundAddedConnection:Disconnect()
		liveSoundAddedConnection = nil
	end

	for obj, data in pairs(hiddenStates) do
		local model = obj and (obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model"))
		local keepHidden = model and isStaleLocalCharacterRoot(model)
		if obj and obj.Parent and not keepHidden then
			if data.type == "BasePart" then
				obj.LocalTransparencyModifier = data.origLocalTrans or 0
				obj.Transparency = data.origTrans
			elseif data.type == "Texture" then
				applyDecalTransparencyState(obj, data.origState)
			elseif data.type == "Effect" then
				setReplayEffectActive(obj, data.origValue, data.prop)
			elseif data.type == "Sound" then
				obj.Volume = data.origVol
			end
		end
	end
	hiddenStates = {}
end

function readStateIfChanged(item, lastState)
	if item.retired then
		return lastState ~= false, false
	end

	local orig = item.orig
	if item.kind == "Props" then
		if not orig or not orig.Parent then
			return lastState ~= false, false
		end
		if orig ~= Lighting
			and not orig:IsDescendantOf(Lighting)
			and not orig:IsDescendantOf(workspace)
			and not orig:IsDescendantOf(SoundService) then
			return lastState ~= false, false
		end

		local currentProps = captureAllPackedProps(orig)
		if lastState and lastState ~= false and packedValuesEqual(currentProps, lastState) then
			return false, lastState
		end

		return true, currentProps
	end

	if not orig or not orig.Parent then
		return lastState ~= false, false
	end
	if not (orig:IsDescendantOf(workspace) or orig:IsDescendantOf(SoundService)) then
		return lastState ~= false, false
	end

	if item.kind == "BasePart" then
		local cf = orig.CFrame
		local size = orig.Size
		local color = orig.Color
		local trans = (orig.Name == "HumanoidRootPart") and 1 or orig.Transparency

		if lastState and lastState ~= false then
			if cf:FuzzyEq(lastState[1], 0.001)
				and (size - lastState[2]).Magnitude <= 0.001
				and color == lastState[3]
				and math.abs(trans - lastState[4]) <= 0.001 then
				return false, lastState
			end
		end

		return true, { cf, size, color, trans }
	elseif item.kind == "Decal" then
		local decalState = getDecalTransparencyState(orig)
		local color = Color3.new(1, 1, 1)
		local texture = ""
		pcall(function() color = orig.Color3 end)
		pcall(function() texture = orig.Texture end)

		if lastState and lastState ~= false then
			if texture == lastState[1]
				and math.abs((decalState[1] or 0) - (lastState[2] or 0)) <= 0.001
				and math.abs((decalState[2] or 0) - (lastState[3] or 0)) <= 0.001
				and color == lastState[4] then
				return false, lastState
			end
		end

		return true, { texture, decalState[1], decalState[2], color }
	elseif item.kind == "Sound" then
		local isPlayingNow = orig.IsPlaying
		local timePosition = orig.TimePosition
		local volume = orig.Volume

		if lastState and lastState ~= false then
			if isPlayingNow == lastState[1]
				and math.abs(timePosition - lastState[2]) <= 0.001
				and math.abs(volume - lastState[3]) <= 0.001 then
				return false, lastState
			end
		end

		return true, { isPlayingNow, timePosition, volume }
	elseif item.kind == "Text" then
		local text = orig.Text
		return text ~= lastState, text
	elseif item.kind == "Enabled" then
		local enabled = orig.Enabled
		return enabled ~= lastState, enabled
	end

	return lastState ~= false, false
end

function encodeSessionForSave(session)
	session.StringArray = session.StringArray or {}
	rebuildStringDictFromArray(session)

	local manifestBuffer = encodeManifestBuffer(session.Manifest or {}, session.StringDict, session.StringArray)
	local manifestLen = buffer.len(manifestBuffer)
	local dictBuffer = buildStringDictionaryBuffer(session.StringArray)
	local dictLen = buffer.len(dictBuffer)

	local frameBuffers = {}
	local framesDataSize = 0
	for i = 1, #session.Frames do
		local fb = session.Frames[i] or false
		frameBuffers[i] = fb
		framesDataSize += fb == false and 4 or (4 + buffer.len(fb))
	end

	local bigBuffer = buffer.create(dictLen + 4 + manifestLen + 4 + framesDataSize)
	buffer.copy(bigBuffer, 0, dictBuffer, 0, dictLen)
	local offset = dictLen

	buffer.writeu32(bigBuffer, offset, manifestLen)
	offset += 4
	buffer.copy(bigBuffer, offset, manifestBuffer, 0, manifestLen)
	offset += manifestLen

	buffer.writeu32(bigBuffer, offset, #frameBuffers)
	offset += 4
	for _, fb in ipairs(frameBuffers) do
		if fb == false then
			buffer.writeu32(bigBuffer, offset, 0)
			offset += 4
		else
			local len = buffer.len(fb)
			buffer.writeu32(bigBuffer, offset, len)
			offset += 4
			buffer.copy(bigBuffer, offset, fb, 0, len)
			offset += len
		end
	end

	local okZstd, compressed = pcall(function()
		return EncodingService:CompressBuffer(bigBuffer, Enum.CompressionAlgorithm.Zstd, 15)
	end)
	if not okZstd or not compressed then
		warn("[Replay] zstd compression failed.")
		return nil
	end

	return {
		Version = REPLAY_VERSION,
		ReplayFPS = session.ReplayFPS or REPLAY_FPS,
		CreatedAt = session.CreatedAt or os.time(),
		Manifest = {},
		RecorderRootId = session.RecorderRootId,
		Data = base64Encode(buffer.tostring(compressed)),
		TotalFrames = #session.Frames,
		TotalBytes = 0,
		Compression = "zstd",
	}
end

function decodeSavedReplay(saved)
	local ok, decoded = pcall(function()
		if typeof(saved) ~= "table" then
			return nil
		end

		local version = tonumber(saved.Version) or 0
		if version < MIN_REPLAY_VERSION then
			warn("[Replay] older replay data cannot be loaded by this decoder.")
			return nil
		end

		local rawStr = saved.Data or ""
		if type(rawStr) ~= "string" or rawStr == "" then
			return nil
		end

		if saved.Compression ~= "zstd" then
			return nil
		end

		local rawBuf = buffer.fromstring(base64Decode(rawStr))
		local okDecompress, decompressed = pcall(function()
			return EncodingService:DecompressBuffer(rawBuf, Enum.CompressionAlgorithm.Zstd)
		end)
		if not okDecompress or not decompressed then
			return nil
		end

		local offset = 0
		local strCount = buffer.readu32(decompressed, offset)
		offset += 4
		local stringArray = {}
		for i = 1, strCount do
			local len, newOff = readVarUInt(decompressed, offset)
			offset = newOff
			stringArray[i] = buffer.readstring(decompressed, offset, len)
			offset += len
		end

		local manifestLen = buffer.readu32(decompressed, offset)
		offset += 4
		local manifestBuf = buffer.create(manifestLen)
		buffer.copy(manifestBuf, 0, decompressed, offset, manifestLen)
		offset += manifestLen

		local decodedManifest = decodeManifestBuffer(manifestBuf, stringArray)

		local numFrames = buffer.readu32(decompressed, offset)
		offset += 4
		local frames = {}
		for i = 1, numFrames do
			local len = buffer.readu32(decompressed, offset)
			offset += 4
			if len == 0 then
				frames[i] = false
			else
				local frameBuf = buffer.create(len)
				buffer.copy(frameBuf, 0, decompressed, offset, len)
				offset += len
				frames[i] = frameBuf
			end
		end

		return {
			Version = version,
			UniqueId = saved.UniqueId,
			ReplayFPS = saved.ReplayFPS or REPLAY_FPS,
			CreatedAt = saved.CreatedAt,
			SavedAt = saved.SavedAt,
			Manifest = decodedManifest,
			RecorderRootId = saved.RecorderRootId,
			Frames = frames,
			StringArray = stringArray,
			TotalBytes = saved.TotalBytes or 0,
			TrackedParts = {},
			TrackedList = {},
			TrackedListDirty = true,
			OrigToClone = {},
			RootClones = {},
			OrigToId = {},
			LastState = {},
			NextId = 1,
			IsLoadedReplay = true,
			IsSaved = true,
			IsSaving = false,
		}
	end)

	if not ok then
		warn("[Replay] saved replay decode failed:", decoded)
		return nil
	end

	return decoded
end

function formatBytes(bytes)
	bytes = tonumber(bytes) or 0
	if bytes < 1024 then
		return math.floor(bytes) .. " B"
	end
	if bytes < 1024 * 1024 then
		return string.format("%.1f KB", bytes / 1024)
	end
	return string.format("%.2f MB", bytes / (1024 * 1024))
end

function trimText(text)
	return tostring(text or ""):match("^%s*(.-)%s*$")
end

SHARE_TEXTBOX_TEXT_LIMIT = 200000
SHARE_CHUNK_BODY_LIMIT = SHARE_TEXTBOX_TEXT_LIMIT
shareExportChunks = {}
shareExportIndex = 1
shareExportRawSize = 0
shareImportChunkGroups = {}

function getShareChunkHeader(chunkId, index, total)
	return "UR17CHUNK|" .. chunkId .. "|" .. index .. "|" .. total .. "|"
end

function getShareChunkBodyLimit(chunkId, total)
	local worstHeader = getShareChunkHeader(chunkId, total, total)
	return math.max(1, SHARE_TEXTBOX_TEXT_LIMIT - #worstHeader)
end

function selectShareCodeText()
	task.defer(function()
		if ShareCodeBox and ShareCodeBox.Parent then
			local textLength = utf8.len(ShareCodeBox.Text) or #ShareCodeBox.Text
			ShareCodeBox:CaptureFocus()
			ShareCodeBox.CursorPosition = 1
			ShareCodeBox.SelectionStart = textLength + 1
		end
	end)
end

function updateShareChunkButtons()
	local hasChunks = shareExportChunks and #shareExportChunks > 1
	if PrevShareChunkBtn then
		PrevShareChunkBtn.Visible = hasChunks
	end
	if NextShareChunkBtn then
		NextShareChunkBtn.Visible = hasChunks
	end
end

function showShareExportChunk(index)
	if not shareExportChunks or #shareExportChunks == 0 then
		updateShareChunkButtons()
		return
	end

	shareExportIndex = math.clamp(index, 1, #shareExportChunks)
	ShareCodeBox.Text = shareExportChunks[shareExportIndex]
	ShareCodeScroll.CanvasPosition = Vector2.new(0, 0)
	updateShareCodeScrollCanvas()
	updateShareChunkButtons()

	if #shareExportChunks > 1 then
		ShareStatusLabel.Text = "Code part " .. shareExportIndex .. "/" .. #shareExportChunks .. ". Copy each part with Ctrl+C. (" .. formatBytes(shareExportRawSize) .. ")"
	else
		ShareStatusLabel.Text = "Code ready. Copy with Ctrl+C. (" .. formatBytes(shareExportRawSize) .. ")"
	end

	selectShareCodeText()
end

function splitShareCodeText(shareText, payload)
	shareExportChunks = {}
	shareExportIndex = 1
	shareExportRawSize = #shareText

	if #shareText <= SHARE_CHUNK_BODY_LIMIT then
		shareExportChunks[1] = shareText
		return
	end

	local chunkId = tostring(payload.CreatedAt or os.time()) .. "-" .. tostring(#shareText) .. "-" .. tostring(math.random(100000, 999999))
	local total = math.ceil(#shareText / SHARE_CHUNK_BODY_LIMIT)
	local bodyLimit = SHARE_CHUNK_BODY_LIMIT

	while true do
		bodyLimit = getShareChunkBodyLimit(chunkId, total)
		local nextTotal = math.ceil(#shareText / bodyLimit)
		if nextTotal == total then
			break
		end
		total = nextTotal
	end

	for i = 1, total do
		local startIndex = ((i - 1) * bodyLimit) + 1
		local body = shareText:sub(startIndex, startIndex + bodyLimit - 1)
		shareExportChunks[i] = getShareChunkHeader(chunkId, i, total) .. body
	end
end

function parseShareCodeChunk(codeText)
	local chunkId, indexText, totalText, body = tostring(codeText or ""):match("^UR17CHUNK|([^|]+)|(%d+)|(%d+)|(.*)$")
	if not chunkId then
		return nil
	end

	local index = tonumber(indexText)
	local total = tonumber(totalText)
	if not index or not total or index < 1 or total < 1 or index > total then
		return nil
	end

	return chunkId, index, total, body or ""
end

function getShareChunkExpectedSize(chunkId)
	local sizeText = tostring(chunkId or ""):match("^%d+%-(%d+)%-")
	return tonumber(sizeText)
end

function exportSessionToShareCode(session)
	if not session or not session.Frames or #session.Frames == 0 then
		ShareStatusLabel.Text = "내보낼 리플레이가 없습니다."
		return
	end

	ShareStatusLabel.Text = "코드 생성 중..."

	task.spawn(function()
		local payload = encodeSessionForSave(session)
		if not payload then
			ShareStatusLabel.Text = "코드 생성 실패"
			return
		end

		local ok, shareText = pcall(function()
			return HttpService:JSONEncode(payload)
		end)

		if ok and type(shareText) == "string" then
			splitShareCodeText(shareText, payload)
			showShareExportChunk(1)
		else
			ShareStatusLabel.Text = "코드 생성 실패"
		end
	end)
end

function importSessionFromShareCode(codeText)
	codeText = trimText(codeText)

	if codeText == "" then
		ShareStatusLabel.Text = "붙여넣은 코드가 없습니다."
		return
	end

	local chunkId, chunkIndex, chunkTotal, chunkBody = parseShareCodeChunk(codeText)
	if chunkId then
		local group = shareImportChunkGroups[chunkId]
		if not group then
			group = { Total = chunkTotal, Parts = {}, Count = 0, Size = 0 }
			shareImportChunkGroups[chunkId] = group
		end

		if group.Total ~= chunkTotal then
			shareImportChunkGroups[chunkId] = nil
			ShareStatusLabel.Text = "Chunk count mismatch. Start import again."
			return
		end

		if not group.Parts[chunkIndex] then
			group.Count += 1
			group.Size += #chunkBody
		else
			group.Size += #chunkBody - #group.Parts[chunkIndex]
		end
		group.Parts[chunkIndex] = chunkBody

		if group.Count < group.Total then
			ShareStatusLabel.Text = "Loaded part " .. chunkIndex .. "/" .. group.Total .. ". Paste next part and press Apply."
			return
		end

		local parts = {}
		for i = 1, group.Total do
			if not group.Parts[i] then
				ShareStatusLabel.Text = "Missing part " .. i .. "/" .. group.Total .. "."
				return
			end
			parts[i] = group.Parts[i]
		end

		codeText = table.concat(parts)
		local expectedSize = getShareChunkExpectedSize(chunkId)
		if expectedSize and #codeText ~= expectedSize then
			ShareStatusLabel.Text = "Code size mismatch. Re-copy the missing or cut part. (" .. formatBytes(#codeText) .. "/" .. formatBytes(expectedSize) .. ")"
			return
		end
		shareImportChunkGroups[chunkId] = nil
	end

	ShareStatusLabel.Text = "코드 적용 중..."

	task.spawn(function()
		local okJson, payload = pcall(function()
			return HttpService:JSONDecode(codeText)
		end)

		if not okJson or typeof(payload) ~= "table" then
			ShareStatusLabel.Text = "잘못된 리플레이 코드입니다."
			return
		end

		local session = decodeSavedReplay(payload)
		if not session then
			ShareStatusLabel.Text = "리플레이를 불러오지 못했습니다."
			return
		end

		session.IsSaved = false
		session.IsSaving = false
		session.UniqueId = nil
		session.TotalBytes = #codeText

		table.insert(Possessions, session)
		refreshReplayList()

		ShareStatusLabel.Text = "코드 적용 완료. 목록에 추가됐습니다."
	end)
end

