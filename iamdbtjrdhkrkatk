local BASE64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local BASE64_LOOKUP = {}
for i = 1, #BASE64 do
	BASE64_LOOKUP[BASE64:sub(i, i)] = i - 1
end

local function base64Encode(data)
	local out = {}
	local len = #data
	for i = 1, len, 3 do
		local b1 = string.byte(data, i) or 0
		local b2 = string.byte(data, i + 1) or 0
		local b3 = string.byte(data, i + 2) or 0
		local n = b1 * 65536 + b2 * 256 + b3
		local c1 = math.floor(n / 262144) % 64
		local c2 = math.floor(n / 4096) % 64
		local c3 = math.floor(n / 64) % 64
		local c4 = n % 64
		out[#out + 1] = BASE64:sub(c1 + 1, c1 + 1)
		out[#out + 1] = BASE64:sub(c2 + 1, c2 + 1)
		out[#out + 1] = i + 1 <= len and BASE64:sub(c3 + 1, c3 + 1) or "="
		out[#out + 1] = i + 2 <= len and BASE64:sub(c4 + 1, c4 + 1) or "="
	end
	return table.concat(out)
end

local function base64Decode(data)
	data = tostring(data):gsub("%s", "")
	local out = {}
	for i = 1, #data, 4 do
		local ch1 = data:sub(i, i)
		local ch2 = data:sub(i + 1, i + 1)
		local ch3 = data:sub(i + 2, i + 2)
		local ch4 = data:sub(i + 3, i + 3)
		local c1 = BASE64_LOOKUP[ch1] or 0
		local c2 = BASE64_LOOKUP[ch2] or 0
		local c3 = BASE64_LOOKUP[ch3] or 0
		local c4 = BASE64_LOOKUP[ch4] or 0
		local n = c1 * 262144 + c2 * 4096 + c3 * 64 + c4
		out[#out + 1] = string.char(math.floor(n / 65536) % 256)
		if ch3 ~= "=" then
			out[#out + 1] = string.char(math.floor(n / 256) % 256)
		end
		if ch4 ~= "=" then
			out[#out + 1] = string.char(n % 256)
		end
	end
	return table.concat(out)
end

local function packPosition(v, scale)
	scale = scale or POS_SCALE
	return math.clamp(math.round(v * scale), -2147483648, 2147483647)
end

local function unpackPosition(x, scale)
	scale = scale or POS_SCALE
	return x / scale
end

local function packSize(v)
	return math.clamp(math.round(v * SIZE_SCALE), 0, 65535)
end

local function unpackSize(x)
	return x / SIZE_SCALE
end

local function packEuler(rx, ry, rz)
	local function comp(angle)
		local norm = (angle + math.pi) / (math.pi * 2)
		return math.clamp(math.round(norm * 1023), 0, 1023)
	end
	return bit32.bor(bit32.lshift(comp(rx), 20), bit32.lshift(comp(ry), 10), comp(rz))
end

local function unpackEuler(packed)
	local function decomp(c)
		return (c / 1023) * (math.pi * 2) - math.pi
	end
	return decomp(bit32.rshift(packed, 20)), decomp(bit32.band(bit32.rshift(packed, 10), 0x3FF)), decomp(bit32.band(packed, 0x3FF))
end

local function packColor555565(r, g, b)
	local r5 = math.clamp(math.floor(r * 31), 0, 31)
	local g6 = math.clamp(math.floor(g * 63), 0, 63)
	local b5 = math.clamp(math.floor(b * 31), 0, 31)
	return bit32.bor(bit32.lshift(r5, 11), bit32.lshift(g6, 5), b5)
end

local function unpackColor555565(packed)
	return Color3.new(bit32.rshift(packed, 11) / 31, bit32.band(bit32.rshift(packed, 5), 0x3F) / 63, bit32.band(packed, 0x1F) / 31)
end

local function writeVarUInt(buf, offset, value)
	while value >= 0x80 do
		buffer.writeu8(buf, offset, bit32.bor(bit32.band(value, 0x7F), 0x80))
		offset += 1
		value = bit32.rshift(value, 7)
	end
	buffer.writeu8(buf, offset, value)
	return offset + 1
end

local function readVarUInt(buf, offset)
	local value = 0
	local shift = 0
	while true do
		local byte = buffer.readu8(buf, offset)
		offset += 1
		value = bit32.bor(value, bit32.lshift(bit32.band(byte, 0x7F), shift))
		if bit32.band(byte, 0x80) == 0 then
			break
		end
		shift += 7
	end
	return value, offset
end

local function getOrCreateStringIndex(dict, arr, str)
	if not str or str == "" then
		return 0
	end
	if dict[str] then
		return dict[str]
	end
	local idx = #arr + 1
	dict[str] = idx
	arr[idx] = str
	return idx
end

local writePackedValue
local readPackedValue

local function estimateFrameChangeBufferSize(frameChanges, trackedParts)
	local total = 32
	for id, state in pairs(frameChanges) do
		local item = trackedParts[id]
		if item then
			total += 5
			if state ~= false then
				if item.kind == "BasePart" then
					total += 32
				elseif item.kind == "Decal" then
					total += 16
				elseif item.kind == "Sound" then
					total += 10
				elseif item.kind == "Text" then
					total += 5
				elseif item.kind == "Enabled" then
					total += 1
				elseif item.kind == "Props" then
					total += 2048
				end
			end
		end
	end
	return total
end

local function serializeBuffer(frameChanges, trackedParts, oldStatesMap, stringDict, stringArray)
	local tempBuf = buffer.create(math.max(128, estimateFrameChangeBufferSize(frameChanges, trackedParts) * 2))
	local offset = 0

	for id, state in pairs(frameChanges) do
		local item = trackedParts[id]
		if item then
			if state == false then
				offset = writeVarUInt(tempBuf, offset, bit32.lshift(id, 1))
			else
				offset = writeVarUInt(tempBuf, offset, bit32.lshift(id, 1) + 1)

				if item.kind == "BasePart" then
					local posScale = item.posScale or POS_SCALE
					local lastState = oldStatesMap[id]
					local mask = 0

					local pos = state[1].Position
					local size = state[2]
					local color = state[3]
					local trans = state[4]
					local rx, ry, rz = state[1]:ToEulerAnglesYXZ()

					local lpx, lpy, lpz = 0, 0, 0
					if lastState then
						lpx = packPosition(lastState[1].Position.X, posScale)
						lpy = packPosition(lastState[1].Position.Y, posScale)
						lpz = packPosition(lastState[1].Position.Z, posScale)
					end

					local px = packPosition(pos.X, posScale)
					local py = packPosition(pos.Y, posScale)
					local pz = packPosition(pos.Z, posScale)
					local dx = px - lpx
					local dy = py - lpy
					local dz = pz - lpz

					if not lastState or dx ~= 0 or dy ~= 0 or dz ~= 0 then
						mask = bit32.bor(mask, 1)
						if lastState and math.abs(dx) <= 127 and math.abs(dy) <= 127 and math.abs(dz) <= 127 then
							mask = bit32.bor(mask, 32)
						end
					end

					local lrx, lry, lrz = 0, 0, 0
					if lastState then
						lrx, lry, lrz = lastState[1]:ToEulerAnglesYXZ()
					end
					if not lastState or (Vector3.new(rx, ry, rz) - Vector3.new(lrx, lry, lrz)).Magnitude > 0.001 then
						mask = bit32.bor(mask, 2)
					end
					if not lastState or (size - lastState[2]).Magnitude > 0.001 then
						mask = bit32.bor(mask, 4)
					end

					local colorChanged = not lastState or math.abs(color.R - lastState[3].R) > 0.01 or math.abs(color.G - lastState[3].G) > 0.01 or math.abs(color.B - lastState[3].B) > 0.01
					local transChanged = not lastState or math.abs(trans - lastState[4]) > 0.01
					if colorChanged then
						mask = bit32.bor(mask, 8)
					end
					if transChanged then
						mask = bit32.bor(mask, 16)
					end

					buffer.writeu8(tempBuf, offset, mask)
					offset += 1

					if bit32.band(mask, 1) ~= 0 then
						if bit32.band(mask, 32) ~= 0 then
							buffer.writei8(tempBuf, offset, dx)
							offset += 1
							buffer.writei8(tempBuf, offset, dy)
							offset += 1
							buffer.writei8(tempBuf, offset, dz)
							offset += 1
						else
							buffer.writei32(tempBuf, offset, px)
							offset += 4
							buffer.writei32(tempBuf, offset, py)
							offset += 4
							buffer.writei32(tempBuf, offset, pz)
							offset += 4
						end
					end

					if bit32.band(mask, 2) ~= 0 then
						buffer.writeu32(tempBuf, offset, packEuler(rx, ry, rz))
						offset += 4
					end
					if bit32.band(mask, 4) ~= 0 then
						buffer.writeu16(tempBuf, offset, packSize(size.X))
						offset += 2
						buffer.writeu16(tempBuf, offset, packSize(size.Y))
						offset += 2
						buffer.writeu16(tempBuf, offset, packSize(size.Z))
						offset += 2
					end
					if bit32.band(mask, 8) ~= 0 then
						buffer.writeu16(tempBuf, offset, packColor555565(color.R, color.G, color.B))
						offset += 2
					end
					if bit32.band(mask, 16) ~= 0 then
						buffer.writeu8(tempBuf, offset, math.clamp(math.round(trans * 255), 0, 255))
						offset += 1
					end
				elseif item.kind == "Decal" then
					local sIdx = getOrCreateStringIndex(stringDict, stringArray, state[1])
					offset = writeVarUInt(tempBuf, offset, sIdx)
					buffer.writef32(tempBuf, offset, state[2] or 0)
					offset += 4
					buffer.writef32(tempBuf, offset, state[3] or 0)
					offset += 4
					local color = state[4] or Color3.new(1, 1, 1)
					buffer.writeu16(tempBuf, offset, packColor555565(color.R, color.G, color.B))
					offset += 2
				elseif item.kind == "Sound" then
					buffer.writeu8(tempBuf, offset, state[1] and 1 or 0)
					offset += 1
					buffer.writef32(tempBuf, offset, state[2])
					offset += 4
					buffer.writef32(tempBuf, offset, state[3])
					offset += 4
				elseif item.kind == "Text" then
					local sIdx = getOrCreateStringIndex(stringDict, stringArray, state)
					offset = writeVarUInt(tempBuf, offset, sIdx)
				elseif item.kind == "Enabled" then
					buffer.writeu8(tempBuf, offset, state and 1 or 0)
					offset += 1
				elseif item.kind == "Props" then
					local propCount = 0
					for _ in pairs(state) do
						propCount += 1
					end
					offset = writeVarUInt(tempBuf, offset, propCount)
					for prop, value in pairs(state) do
						offset = writeVarUInt(tempBuf, offset, getOrCreateStringIndex(stringDict, stringArray, prop))
						offset = writePackedValue(tempBuf, offset, value, stringDict, stringArray)
					end
				end
			end
		end
	end

	if offset == 0 then
		return false
	end

	local finalBuf = buffer.create(offset)
	buffer.copy(finalBuf, 0, tempBuf, 0, offset)
	return finalBuf
end

local function deserializeBufferUnsafe(buf, trackedParts, targetState, stringArray)
	if not buf then
		return true
	end

	local size = buffer.len(buf)
	local offset = 0

	while offset < size do
		local val, newOff = readVarUInt(buf, offset)
		offset = newOff
		local id = bit32.rshift(val, 1)
		local isValid = bit32.band(val, 1) == 1
		local item = trackedParts[id]
		if not item then
			break
		end

		if not isValid then
			targetState[id] = false
		elseif item.kind == "BasePart" then
			local posScale = item.posScale or POS_SCALE
			local mask = buffer.readu8(buf, offset)
			offset += 1
			local oldState = targetState[id]

			local px, py, pz = 0, 0, 0
			local rx, ry, rz = 0, 0, 0
			local sx, sy, sz = 1, 1, 1
			local r, g, b = 1, 1, 1
			local trans = 0
			local packedPx, packedPy, packedPz = 0, 0, 0

			if oldState and oldState ~= false then
				packedPx = packPosition(oldState[1].Position.X, posScale)
				packedPy = packPosition(oldState[1].Position.Y, posScale)
				packedPz = packPosition(oldState[1].Position.Z, posScale)
				rx, ry, rz = oldState[1]:ToEulerAnglesYXZ()
				sx, sy, sz = oldState[2].X, oldState[2].Y, oldState[2].Z
				r, g, b = oldState[3].R, oldState[3].G, oldState[3].B
				trans = oldState[4]
			end

			if bit32.band(mask, 1) ~= 0 then
				if bit32.band(mask, 32) ~= 0 then
					packedPx += buffer.readi8(buf, offset)
					offset += 1
					packedPy += buffer.readi8(buf, offset)
					offset += 1
					packedPz += buffer.readi8(buf, offset)
					offset += 1
				else
					packedPx = buffer.readi32(buf, offset)
					offset += 4
					packedPy = buffer.readi32(buf, offset)
					offset += 4
					packedPz = buffer.readi32(buf, offset)
					offset += 4
				end
			end

			px, py, pz = unpackPosition(packedPx, posScale), unpackPosition(packedPy, posScale), unpackPosition(packedPz, posScale)

			if bit32.band(mask, 2) ~= 0 then
				rx, ry, rz = unpackEuler(buffer.readu32(buf, offset))
				offset += 4
			end
			if bit32.band(mask, 4) ~= 0 then
				sx = unpackSize(buffer.readu16(buf, offset))
				offset += 2
				sy = unpackSize(buffer.readu16(buf, offset))
				offset += 2
				sz = unpackSize(buffer.readu16(buf, offset))
				offset += 2
			end
			if bit32.band(mask, 8) ~= 0 then
				local packedCol = buffer.readu16(buf, offset)
				offset += 2
				local col = unpackColor555565(packedCol)
				r, g, b = col.R, col.G, col.B
			end
			if bit32.band(mask, 16) ~= 0 then
				trans = buffer.readu8(buf, offset) / 255
				offset += 1
			end

			targetState[id] = {
				CFrame.new(px, py, pz) * CFrame.fromEulerAnglesYXZ(rx, ry, rz),
				Vector3.new(sx, sy, sz),
				Color3.new(r, g, b),
				trans,
			}
		elseif item.kind == "Decal" then
			local sIdx, nextOff = readVarUInt(buf, offset)
			offset = nextOff
			local texture = sIdx == 0 and "" or (stringArray[sIdx] or "")
			local transparency = buffer.readf32(buf, offset)
			offset += 4
			local localModifier = buffer.readf32(buf, offset)
			offset += 4
			local packedCol = buffer.readu16(buf, offset)
			offset += 2
			local col = unpackColor555565(packedCol)
			targetState[id] = { texture, transparency, localModifier, col }
		elseif item.kind == "Sound" then
			local isPlay = buffer.readu8(buf, offset) == 1
			offset += 1
			local tPos = buffer.readf32(buf, offset)
			offset += 4
			local vol = buffer.readf32(buf, offset)
			offset += 4
			targetState[id] = { isPlay, tPos, vol }
		elseif item.kind == "Text" then
			local sIdx, nextOff = readVarUInt(buf, offset)
			offset = nextOff
			targetState[id] = sIdx == 0 and "" or (stringArray[sIdx] or "")
		elseif item.kind == "Enabled" then
			targetState[id] = buffer.readu8(buf, offset) == 1
			offset += 1
		elseif item.kind == "Props" then
			local propCount
			propCount, offset = readVarUInt(buf, offset)
			local props = {}
			for _ = 1, propCount do
				local propIdx
				propIdx, offset = readVarUInt(buf, offset)
				local propName = propIdx == 0 and "" or (stringArray[propIdx] or "")
				local value
				value, offset = readPackedValue(buf, offset, stringArray)
				if propName ~= "" and value ~= nil then
					props[propName] = value
				end
			end
			targetState[id] = props
		end
	end

	return true
end

local function deserializeBuffer(buf, trackedParts, targetState, stringArray)
	local ok, result = pcall(deserializeBufferUnsafe, buf, trackedParts, targetState, stringArray)
	if not ok then
		warn("[Replay] frame decode failed:", result)
		return false
	end
	return result ~= false
end

