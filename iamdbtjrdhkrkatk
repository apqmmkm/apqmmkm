end

RecordBtn.MouseButton1Click:Connect(function()
	if isReplayMode then
		return
	end
	ListPanel.Visible = false

	if isRecording then
		isRecording = false
		if recordingConnection then
			recordingConnection:Disconnect()
			recordingConnection = nil
		end
		if recAddedConnection then
			recAddedConnection:Disconnect()
			recAddedConnection = nil
		end
		if recAddedSoundConnection then
			recAddedSoundConnection:Disconnect()
			recAddedSoundConnection = nil
		end
		if recCharacterConnection then
			recCharacterConnection:Disconnect()
			recCharacterConnection = nil
		end
		if recAddedLightingConnection then
			recAddedLightingConnection:Disconnect()
			recAddedLightingConnection = nil
		end
		disconnectRecordChangeSignals(currentSession)

		RecordBtn.Text = "⏺ 녹화 시작"
		RecordBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
		OpenListBtn.Visible = true

		if currentSession and #currentSession.Frames > 0 then
			currentSession.IsSaved = false
			currentSession.IsSaving = false
			currentSession.UniqueId = nil
			refreshReplayList()
			ListPanel.Visible = true
			ShareStatusLabel.Text = SaveReplayFunction and "녹화 완료. 저장 버튼을 누르면 영구 저장됩니다." or "녹화 완료. 코드 버튼으로 내보낼 수 있습니다."
		end
	else
		isRecording = true
		RecordBtn.Text = "⏹ 녹화 중지"
		RecordBtn.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
		OpenListBtn.Visible = false

		currentSession = {
			Version = REPLAY_VERSION,
			ReplayFPS = REPLAY_FPS,
			CreatedAt = os.time(),
			Manifest = {},
			OrigToId = {},
			Frames = {},
			StringDict = {},
			StringArray = {},
			TrackedParts = {},
			OrigToClone = {},
			RootClones = {},
			LastState = {},
			NextId = 1,
			TotalBytes = 0,
			IsSaved = false,
			IsSaving = false,
			RecorderRootId = nil,
			LocalCharacterRoot = player.Character,
			RetiredRoots = {},
			PendingCharacterRoots = {},
			TrackedList = {},
			TrackedListDirty = true,
			RecordBucketsDirty = true,
			RecordChangeConnections = {},
			PendingInitialRecordItems = {},
			DirtyRecordItems = {},
			RecordFrameScratch = {},
			RecordFrameSeen = {},
			FrameChangesScratch = {},
			OldStatesScratch = {},
			RegisteredRoots = {},
			RecordFrameIndex = 0,
		}
		table.insert(Possessions, currentSession)
		local recordingSession = currentSession

		ShareStatusLabel.Text = "녹화 대상 준비 중..."
		registerDescendantsBatched(workspace, registerEntity)
		registerDescendantsBatched(SoundService, registerEntity)
		if not isRecording or currentSession ~= recordingSession then
			return
		end
		registerLightingTree(Lighting)
		updateRecorderRootId(currentSession)
		ShareStatusLabel.Text = "녹화 중..."

		recAddedConnection = workspace.DescendantAdded:Connect(registerEntity)
		recAddedSoundConnection = SoundService.DescendantAdded:Connect(registerEntity)
		recAddedLightingConnection = Lighting.DescendantAdded:Connect(registerLightingTree)
		addRecordSignal(currentSession, workspace.DescendantRemoving:Connect(function(obj)
			if isRecording and currentSession == recordingSession then
				markTrackedObjectDirty(recordingSession, obj)
			end
		end))
		addRecordSignal(currentSession, SoundService.DescendantRemoving:Connect(function(obj)
			if isRecording and currentSession == recordingSession then
				markTrackedObjectDirty(recordingSession, obj)
			end
		end))
		addRecordSignal(currentSession, Lighting.DescendantRemoving:Connect(function(obj)
			if isRecording and currentSession == recordingSession then
				markTrackedObjectDirty(recordingSession, obj)
			end
		end))
		recCharacterConnection = player.CharacterAdded:Connect(function(character)
			local session = currentSession
			if not isRecording or not session then
				return
			end

			local previousRoot = session.LocalCharacterRoot
			if previousRoot and previousRoot ~= character then
				retireTrackedTree(session, previousRoot)
			end
			session.LocalCharacterRoot = character

			registerCharacterWhenStable(session, character)
		end)
		recordAccumulator = 0

		recordingConnection = RunService.Heartbeat:Connect(function(dt)
			recordAccumulator += dt
			local catchupFrames = 0
			while recordAccumulator >= frameStep and catchupFrames < RECORD_MAX_CATCHUP_FRAMES do
				recordAccumulator -= frameStep
				catchupFrames += 1
				currentSession.RecordFrameIndex = (currentSession.RecordFrameIndex or 0) + 1
				updateRecorderRootId(currentSession)
				local frameChanges = currentSession.FrameChangesScratch or {}
				for key in pairs(frameChanges) do
					frameChanges[key] = nil
				end
				currentSession.FrameChangesScratch = frameChanges
				local oldStates = currentSession.OldStatesScratch or {}
				for key in pairs(oldStates) do
					oldStates[key] = nil
				end
				currentSession.OldStatesScratch = oldStates
				local hasChanges = false

				for _, item in ipairs(getRecordItemsForFrame(currentSession, currentSession.RecordFrameIndex)) do
					local id = item.id
					local changed, currentState = readStateIfChanged(item, currentSession.LastState[id])
					if changed then
						frameChanges[id] = currentState
						oldStates[id] = currentSession.LastState[id]
						currentSession.LastState[id] = currentState
						hasChanges = true
					end
				end

				local packedBuffer = hasChanges and serializeBuffer(frameChanges, currentSession.TrackedParts, oldStates, currentSession.StringDict, currentSession.StringArray) or false
				table.insert(currentSession.Frames, packedBuffer)
				currentSession.TotalBytes += packedBuffer and (buffer.len(packedBuffer) + 4) or 4
			end
			if recordAccumulator >= frameStep then
				recordAccumulator = 0
			end
		end)
	end
end)

