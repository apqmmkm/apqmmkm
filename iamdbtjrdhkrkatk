	for _, child in pairs(PlayerGui:GetChildren()) do
		if child:IsA("ScreenGui") and child.Name ~= "UltimateReplayGui" then
			if child.Enabled then
				if hiddenOtherGuis[child] == nil then
					hiddenOtherGuis[child] = true
				end
				child.Enabled = false
			end
		elseif child:IsA("Folder") then
			for _, folderChild in pairs(child:GetChildren()) do
				if folderChild:IsA("ScreenGui") and folderChild.Name ~= "UltimateReplayGui" and folderChild.Enabled then
					if hiddenOtherGuis[folderChild] == nil then
						hiddenOtherGuis[folderChild] = true
					end
					folderChild.Enabled = false
				end
			end
		end
	end
end

