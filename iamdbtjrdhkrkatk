function getReplayEffectActiveState(obj)
	local okEnabled, enabled = pcall(function()
		return obj.Enabled
	end)
	if okEnabled then
		return "Enabled", enabled
	end

	local okVisible, visible = pcall(function()
		return obj.Visible
	end)
	if okVisible then
		return "Visible", visible
	end

	return nil, nil
end

function setReplayEffectActive(obj, active, prop)
