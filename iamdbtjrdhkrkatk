local function estimateVarUIntSize(value)
	value = math.max(0, tonumber(value) or 0)
	local bytes = 1
	while value >= 0x80 do
		bytes += 1
		value = math.floor(value / 128)
	end
	return bytes
end

local function estimateStringIndexSize()
	return 5
end

local function estimatePackedValueSize(v)
	if v == nil then
		return 1
	end

	local valueType = type(v)
	if valueType == "number" then
		return 9
	elseif valueType == "string" then
		return 1 + estimateStringIndexSize()
	elseif valueType == "boolean" then
		return 1
	elseif valueType ~= "table" or not v.__t then
		return 1
	end

	if v.__t == "Vector2" then
		return 1 + 8
	elseif v.__t == "Vector3" or v.__t == "Color3" then
		return 1 + 12
	elseif v.__t == "CFrame" then
		return 1 + 48
	elseif v.__t == "UDim" then
		return 1 + 8
	elseif v.__t == "UDim2" then
		return 1 + 16
	elseif v.__t == "EnumItem" then
		return 1 + estimateStringIndexSize()
	elseif v.__t == "NumberRange" then
		return 1 + 8
	elseif v.__t == "NumberSequence" then
		local count = #(v.Keypoints or {})
		return 1 + estimateVarUIntSize(count) + count * 12
	elseif v.__t == "ColorSequence" then
		local count = #(v.Keypoints or {})
		return 1 + estimateVarUIntSize(count) + count * 16
	end

	return 1
end

local function writeStringIndex(buf, offset, stringDict, stringArray, value)
	return writeVarUInt(buf, offset, getOrCreateStringIndex(stringDict, stringArray, value))
end

local function readStringIndex(buf, offset, stringArray)
	local idx, nextOffset = readVarUInt(buf, offset)
	return idx == 0 and "" or (stringArray[idx] or ""), nextOffset
end

function writePackedValue(buf, offset, value, stringDict, stringArray)
	if value == nil then
		buffer.writeu8(buf, offset, VALUE_NIL)
		return offset + 1
	end

	local valueType = type(value)
	if valueType == "number" then
		buffer.writeu8(buf, offset, VALUE_NUMBER64)
		offset += 1
		buffer.writef64(buf, offset, value)
		return offset + 8
	elseif valueType == "string" then
		buffer.writeu8(buf, offset, VALUE_STRING)
		offset += 1
		return writeStringIndex(buf, offset, stringDict, stringArray, value)
	elseif valueType == "boolean" then
		buffer.writeu8(buf, offset, value and VALUE_TRUE or VALUE_FALSE)
		return offset + 1
	end

	if typeof(value) ~= "table" or not value.__t then
		buffer.writeu8(buf, offset, VALUE_NIL)
		return offset + 1
	end

	if value.__t == "Vector2" then
		buffer.writeu8(buf, offset, VALUE_VECTOR2)
		offset += 1
		buffer.writef32(buf, offset, value.X or 0)
		offset += 4
		buffer.writef32(buf, offset, value.Y or 0)
		offset += 4
	elseif value.__t == "Vector3" then
		buffer.writeu8(buf, offset, VALUE_VECTOR3)
		offset += 1
		buffer.writef32(buf, offset, value.X or 0)
		offset += 4
		buffer.writef32(buf, offset, value.Y or 0)
		offset += 4
		buffer.writef32(buf, offset, value.Z or 0)
		offset += 4
	elseif value.__t == "Color3" then
		buffer.writeu8(buf, offset, VALUE_COLOR3)
		offset += 1
		buffer.writef32(buf, offset, value.R or 1)
		offset += 4
		buffer.writef32(buf, offset, value.G or 1)
		offset += 4
		buffer.writef32(buf, offset, value.B or 1)
		offset += 4
	elseif value.__t == "CFrame" then
		buffer.writeu8(buf, offset, VALUE_CFRAME)
		offset += 1
		local values = value.Values or {}
		for i = 1, 12 do
			buffer.writef32(buf, offset, values[i] or ((i == 4 or i == 8 or i == 12) and 1 or 0))
			offset += 4
		end
	elseif value.__t == "UDim" then
		buffer.writeu8(buf, offset, VALUE_UDIM)
		offset += 1
		buffer.writef32(buf, offset, value.Scale or 0)
		offset += 4
		buffer.writei32(buf, offset, math.round(value.Offset or 0))
		offset += 4
	elseif value.__t == "UDim2" then
		buffer.writeu8(buf, offset, VALUE_UDIM2)
		offset += 1
		buffer.writef32(buf, offset, value.XS or 0)
		offset += 4
		buffer.writei32(buf, offset, math.round(value.XO or 0))
		offset += 4
		buffer.writef32(buf, offset, value.YS or 0)
		offset += 4
		buffer.writei32(buf, offset, math.round(value.YO or 0))
		offset += 4
	elseif value.__t == "EnumItem" then
		buffer.writeu8(buf, offset, VALUE_ENUM)
		offset += 1
		offset = writeStringIndex(buf, offset, stringDict, stringArray, value.Value or "")
	elseif value.__t == "NumberRange" then
		buffer.writeu8(buf, offset, VALUE_NUMBER_RANGE)
		offset += 1
		buffer.writef32(buf, offset, value.Min or 0)
		offset += 4
		buffer.writef32(buf, offset, value.Max or 0)
		offset += 4
	elseif value.__t == "NumberSequence" then
		buffer.writeu8(buf, offset, VALUE_NUMBER_SEQUENCE)
		offset += 1
		local keypoints = value.Keypoints or {}
		offset = writeVarUInt(buf, offset, #keypoints)
		for _, kp in ipairs(keypoints) do
			buffer.writef32(buf, offset, kp.Time or 0)
			offset += 4
			buffer.writef32(buf, offset, kp.Value or 0)
			offset += 4
			buffer.writef32(buf, offset, kp.Envelope or 0)
			offset += 4
		end
	elseif value.__t == "ColorSequence" then
		buffer.writeu8(buf, offset, VALUE_COLOR_SEQUENCE)
		offset += 1
		local keypoints = value.Keypoints or {}
		offset = writeVarUInt(buf, offset, #keypoints)
		for _, kp in ipairs(keypoints) do
			local color = kp.Color or {}
			buffer.writef32(buf, offset, kp.Time or 0)
			offset += 4
			buffer.writef32(buf, offset, color.R or 1)
			offset += 4
			buffer.writef32(buf, offset, color.G or 1)
			offset += 4
			buffer.writef32(buf, offset, color.B or 1)
			offset += 4
		end
	else
		buffer.writeu8(buf, offset, VALUE_NIL)
		offset += 1
	end

	return offset
end

function readPackedValue(buf, offset, stringArray)
	local code = buffer.readu8(buf, offset)
	offset += 1

	if code == VALUE_NIL then
		return nil, offset
	elseif code == VALUE_NUMBER then
		local value = buffer.readf32(buf, offset)
		return value, offset + 4
	elseif code == VALUE_NUMBER64 then
		local value = buffer.readf64(buf, offset)
		return value, offset + 8
	elseif code == VALUE_STRING then
		return readStringIndex(buf, offset, stringArray)
	elseif code == VALUE_FALSE then
		return false, offset
	elseif code == VALUE_TRUE then
		return true, offset
	elseif code == VALUE_VECTOR2 then
		local x = buffer.readf32(buf, offset)
		offset += 4
		local y = buffer.readf32(buf, offset)
		offset += 4
		return { __t = "Vector2", X = x, Y = y }, offset
	elseif code == VALUE_VECTOR3 then
		local x = buffer.readf32(buf, offset)
		offset += 4
		local y = buffer.readf32(buf, offset)
		offset += 4
		local z = buffer.readf32(buf, offset)
		offset += 4
		return { __t = "Vector3", X = x, Y = y, Z = z }, offset
	elseif code == VALUE_COLOR3 then
		local r = buffer.readf32(buf, offset)
		offset += 4
		local g = buffer.readf32(buf, offset)
		offset += 4
		local b = buffer.readf32(buf, offset)
		offset += 4
		return { __t = "Color3", R = r, G = g, B = b }, offset
	elseif code == VALUE_CFRAME then
		local values = {}
		for i = 1, 12 do
			values[i] = buffer.readf32(buf, offset)
			offset += 4
		end
		return { __t = "CFrame", Values = values }, offset
	elseif code == VALUE_UDIM then
		local scale = buffer.readf32(buf, offset)
		offset += 4
		local offsetValue = buffer.readi32(buf, offset)
		offset += 4
		return { __t = "UDim", Scale = scale, Offset = offsetValue }, offset
	elseif code == VALUE_UDIM2 then
		local xs = buffer.readf32(buf, offset)
		offset += 4
		local xo = buffer.readi32(buf, offset)
		offset += 4
		local ys = buffer.readf32(buf, offset)
		offset += 4
		local yo = buffer.readi32(buf, offset)
		offset += 4
		return { __t = "UDim2", XS = xs, XO = xo, YS = ys, YO = yo }, offset
	elseif code == VALUE_ENUM then
		local value
		value, offset = readStringIndex(buf, offset, stringArray)
		return { __t = "EnumItem", Value = value }, offset
	elseif code == VALUE_NUMBER_RANGE then
		local min = buffer.readf32(buf, offset)
		offset += 4
		local max = buffer.readf32(buf, offset)
		offset += 4
		return { __t = "NumberRange", Min = min, Max = max }, offset
	elseif code == VALUE_NUMBER_SEQUENCE then
		local count
		count, offset = readVarUInt(buf, offset)
		local keypoints = {}
		for i = 1, count do
			local time = buffer.readf32(buf, offset)
			offset += 4
			local value = buffer.readf32(buf, offset)
			offset += 4
			local envelope = buffer.readf32(buf, offset)
			offset += 4
			keypoints[i] = { Time = time, Value = value, Envelope = envelope }
		end
		return { __t = "NumberSequence", Keypoints = keypoints }, offset
	elseif code == VALUE_COLOR_SEQUENCE then
		local count
		count, offset = readVarUInt(buf, offset)
		local keypoints = {}
		for i = 1, count do
			local time = buffer.readf32(buf, offset)
			offset += 4
			local r = buffer.readf32(buf, offset)
			offset += 4
			local g = buffer.readf32(buf, offset)
			offset += 4
			local b = buffer.readf32(buf, offset)
			offset += 4
			keypoints[i] = { Time = time, Color = { __t = "Color3", R = r, G = g, B = b } }
		end
		return { __t = "ColorSequence", Keypoints = keypoints }, offset
	end

	return nil, offset
end

local function buildStringDictionaryBuffer(strArr)
	local size = 4
	for i = 1, #strArr do
		local str = strArr[i] or ""
		size += estimateVarUIntSize(#str) + #str
	end

	local dictBuf = buffer.create(size)
	local offset = 0
	buffer.writeu32(dictBuf, offset, #strArr)
	offset += 4
	for i = 1, #strArr do
		local str = strArr[i] or ""
		offset = writeVarUInt(dictBuf, offset, #str)
		buffer.writestring(dictBuf, offset, str, #str)
		offset += #str
	end

	return dictBuf
end

local function rebuildStringDictFromArray(session)
	session.StringArray = session.StringArray or {}
	session.StringDict = {}
	for i, str in ipairs(session.StringArray) do
		if type(str) == "string" and str ~= "" and session.StringDict[str] == nil then
			session.StringDict[str] = i
		end
	end
end

function encodeCSGRecipeForManifest(recipe)
	if typeof(recipe) ~= "table" then
		return ""
	end

	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(recipe)
	end)
	if ok and type(encoded) == "string" then
		return encoded
	end

	return ""
end

function decodeCSGRecipeFromManifest(recipeText)
	if type(recipeText) ~= "string" or recipeText == "" then
		return nil
	end

	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(recipeText)
	end)
	if ok and typeof(decoded) == "table" then
		return decoded
	end

	return nil
end

function estimateManifestEntrySize(data)
	local size = 64
	local props = data.Props or {}
	for _, value in pairs(props) do
		size += estimateStringIndexSize() + estimatePackedValueSize(value)
	end

	local path = data.SourcePath or {}
	size += estimateVarUIntSize(#path)
	for _, entry in ipairs(path) do
		size += estimateStringIndexSize() * 2 + estimateVarUIntSize(entry.Index or 1)
	end

	if data.MeshSize then
		size += estimatePackedValueSize(data.MeshSize)
	end

	local refs = data.Refs or {}
	for _, value in pairs(refs) do
		size += estimateStringIndexSize() + estimateVarUIntSize(value)
	end

	if data.PosScale then
		size += estimateVarUIntSize(data.PosScale)
	end

	if data.CSGRecipe then
		size += estimateStringIndexSize()
	end

	return size
end

function encodeManifestBuffer(manifest, stringDict, stringArray)
	local entries = {}
	local estimate = 16
	for id, data in pairs(manifest or {}) do
		local numericId = tonumber(id) or tonumber(data.Id)
		if numericId and typeof(data) == "table" then
			entries[#entries + 1] = { id = numericId, data = data }
			estimate += estimateManifestEntrySize(data)
		end
	end
	table.sort(entries, function(a, b)
		return a.id < b.id
	end)

	local manifestBuf = buffer.create(estimate * 2 + 1024)
	local offset = 0
	offset = writeVarUInt(manifestBuf, offset, #entries)

	for _, entry in ipairs(entries) do
		local id = entry.id
		local data = entry.data
		local props = data.Props or {}
		local sourcePath = data.SourcePath or {}
		local parentId = tonumber(data.ParentId) or 0
		local trackKind = data.TrackKind or ""

		offset = writeVarUInt(manifestBuf, offset, id)
		offset = writeStringIndex(manifestBuf, offset, stringDict, stringArray, data.ClassName or "")
		offset = writeStringIndex(manifestBuf, offset, stringDict, stringArray, data.Name or "")
		offset = writeStringIndex(manifestBuf, offset, stringDict, stringArray, trackKind)
		offset = writeVarUInt(manifestBuf, offset, parentId)

		local propCount = 0
		for _ in pairs(props) do
			propCount += 1
		end
		offset = writeVarUInt(manifestBuf, offset, propCount)
		for prop, value in pairs(props) do
			offset = writeStringIndex(manifestBuf, offset, stringDict, stringArray, prop)
			offset = writePackedValue(manifestBuf, offset, value, stringDict, stringArray)
		end

		offset = writeVarUInt(manifestBuf, offset, #sourcePath)
		for _, pathEntry in ipairs(sourcePath) do
			offset = writeStringIndex(manifestBuf, offset, stringDict, stringArray, pathEntry.Name or "")
			offset = writeStringIndex(manifestBuf, offset, stringDict, stringArray, pathEntry.ClassName or "")
			offset = writeVarUInt(manifestBuf, offset, tonumber(pathEntry.Index) or 1)
		end

		local refs = data.Refs or {}
		local refCount = 0
		for _ in pairs(refs) do
			refCount += 1
		end

		local extraMask = 0
		if data.MeshSize then
			extraMask = bit32.bor(extraMask, 1)
		end
		if refCount > 0 then
			extraMask = bit32.bor(extraMask, 2)
		end
		if data.PosScale then
			extraMask = bit32.bor(extraMask, 4)
		end
		if data.CSGRecipe then
			extraMask = bit32.bor(extraMask, 8)
		end
		buffer.writeu8(manifestBuf, offset, extraMask)
		offset += 1

		if bit32.band(extraMask, 1) ~= 0 then
			offset = writePackedValue(manifestBuf, offset, data.MeshSize, stringDict, stringArray)
		end
		if bit32.band(extraMask, 2) ~= 0 then
			offset = writeVarUInt(manifestBuf, offset, refCount)
			for refName, refId in pairs(refs) do
				offset = writeStringIndex(manifestBuf, offset, stringDict, stringArray, refName)
				offset = writeVarUInt(manifestBuf, offset, tonumber(refId) or 0)
			end
		end
		if bit32.band(extraMask, 4) ~= 0 then
			offset = writeVarUInt(manifestBuf, offset, tonumber(data.PosScale) or POS_SCALE)
		end
		if bit32.band(extraMask, 8) ~= 0 then
			offset = writeStringIndex(manifestBuf, offset, stringDict, stringArray, encodeCSGRecipeForManifest(data.CSGRecipe))
		end
	end

	local finalBuf = buffer.create(offset)
	buffer.copy(finalBuf, 0, manifestBuf, 0, offset)
	return finalBuf
end

function decodeManifestBuffer(manifestBuf, stringArray)
	local manifest = {}
	local offset = 0
	local entryCount
	entryCount, offset = readVarUInt(manifestBuf, offset)

	for _ = 1, entryCount do
		local id
		id, offset = readVarUInt(manifestBuf, offset)

		local className, name, trackKind
		className, offset = readStringIndex(manifestBuf, offset, stringArray)
		name, offset = readStringIndex(manifestBuf, offset, stringArray)
		trackKind, offset = readStringIndex(manifestBuf, offset, stringArray)

		local parentId
		parentId, offset = readVarUInt(manifestBuf, offset)

		local props = {}
		local propCount
		propCount, offset = readVarUInt(manifestBuf, offset)
		for _ = 1, propCount do
			local propName
			propName, offset = readStringIndex(manifestBuf, offset, stringArray)
			local value
			value, offset = readPackedValue(manifestBuf, offset, stringArray)
			if propName ~= "" and value ~= nil then
				props[propName] = value
			end
		end

		local sourcePath = {}
		local pathCount
		pathCount, offset = readVarUInt(manifestBuf, offset)
		for i = 1, pathCount do
			local pathName, pathClassName, index
			pathName, offset = readStringIndex(manifestBuf, offset, stringArray)
			pathClassName, offset = readStringIndex(manifestBuf, offset, stringArray)
			index, offset = readVarUInt(manifestBuf, offset)
			sourcePath[i] = { Name = pathName, ClassName = pathClassName, Index = index }
		end

		local data = {
			Id = id,
			ClassName = className,
			Name = name,
			TrackKind = trackKind ~= "" and trackKind or nil,
			Props = props,
			ParentId = parentId ~= 0 and parentId or nil,
			SourcePath = sourcePath,
		}

		local extraMask = buffer.readu8(manifestBuf, offset)
		offset += 1
		if bit32.band(extraMask, 1) ~= 0 then
			data.MeshSize, offset = readPackedValue(manifestBuf, offset, stringArray)
		end
		if bit32.band(extraMask, 2) ~= 0 then
			local refCount
			refCount, offset = readVarUInt(manifestBuf, offset)
			local refs = {}
			for _ = 1, refCount do
				local refName, refId
				refName, offset = readStringIndex(manifestBuf, offset, stringArray)
				refId, offset = readVarUInt(manifestBuf, offset)
				if refName ~= "" then
					refs[refName] = refId
				end
			end
			if next(refs) then
				data.Refs = refs
			end
		end
		if bit32.band(extraMask, 4) ~= 0 then
			data.PosScale, offset = readVarUInt(manifestBuf, offset)
		end
		if bit32.band(extraMask, 8) ~= 0 then
			local recipeText
			recipeText, offset = readStringIndex(manifestBuf, offset, stringArray)
			data.CSGRecipe = decodeCSGRecipeFromManifest(recipeText)
		end

		if className == "MeshPart" then
			data.MeshId = props.MeshId
			data.TextureID = props.TextureID
		elseif className == "UnionOperation" then
			data.UsePartColor = props.UsePartColor
			data.RenderFidelity = props.RenderFidelity
			data.CollisionFidelity = props.CollisionFidelity
		elseif className == "SpecialMesh" then
			data.MeshId = props.MeshId
			data.TextureId = props.TextureId
			data.MeshType = props.MeshType
		elseif className == "SurfaceAppearance" then
			data.ColorMap = props.ColorMap
			data.MetalnessMap = props.MetalnessMap
			data.NormalMap = props.NormalMap
			data.RoughnessMap = props.RoughnessMap
			data.AlphaMode = props.AlphaMode
		end

		manifest[id] = data
	end

	return manifest
end

function getRawProp(props, name)
	if typeof(props) ~= "table" then
		return nil
	end
	local value = props[name]
	if typeof(value) == "table" and value.__t then
		return unpackValue(value)
	end
	return value
end

function getDecalTransparencyState(obj)
	local transparency = 0
	local localModifier = 0
	pcall(function() transparency = obj.Transparency end)
	pcall(function() localModifier = obj.LocalTransparencyModifier end)
	return { transparency, localModifier }
end

function applyDecalTransparencyState(obj, state)
	if type(state) == "number" then
		pcall(function() obj.Transparency = state end)
		return
	end
	if type(state) ~= "table" then
		return
	end
	pcall(function() obj.Transparency = state[1] or 0 end)
	pcall(function() obj.LocalTransparencyModifier = state[2] or 0 end)
end

function isBlankContentId(value)
	value = tostring(value or "")
	return value == "" or value == "0" or value == "rbxassetid://" or value == "rbxassetid://0"
end

function hasTexturedHeadMesh(head)
	if not head or not head:IsA("BasePart") or head.Name ~= "Head" then
		return false
	end

	if head:IsA("MeshPart") then
		local textureId = ""
		pcall(function() textureId = head.TextureID end)
		if not isBlankContentId(textureId) then
			return true
		end
	end

	for _, child in ipairs(head:GetChildren()) do
		if child:IsA("SpecialMesh") then
			local textureId = ""
			pcall(function() textureId = child.TextureId end)
			if not isBlankContentId(textureId) then
				return true
			end
		elseif child:IsA("SurfaceAppearance") then
			local colorMap = ""
			pcall(function() colorMap = child.ColorMap end)
			if not isBlankContentId(colorMap) then
				return true
			end
		end
	end

	return false
end

function isDuplicateDefaultFace(obj)
	if not (obj:IsA("Decal") or obj:IsA("Texture")) then
		return false
	end
	if string.lower(obj.Name) ~= "face" then
		return false
	end
	return hasTexturedHeadMesh(obj.Parent)
end

function isCharacterObject(obj)
	local model = obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model")
	return model and model:FindFirstChildOfClass("Humanoid") ~= nil
end

function isLightingReplayObject(obj)
	return obj == Lighting or obj:IsDescendantOf(Lighting)
end

function getReplayPositionScale(obj)
	return isCharacterObject(obj) and CHARACTER_POS_SCALE or MAP_POS_SCALE
end

function hasReplayDynamicHint(obj)
	local cur = obj
	while cur do
		local dynamic = false
		pcall(function()
			dynamic = cur:GetAttribute("ReplayDynamic") == true or cur:GetAttribute("ReplayAlwaysRecord") == true
		end)
		if dynamic then
			return true
		end
		if cur == workspace or cur == SoundService or cur == Lighting then
			break
		end
		cur = cur.Parent
	end
	return false
end

function shouldRecordMapObjectEveryFrame(obj, kind)
	if isCharacterObject(obj) or hasReplayDynamicHint(obj) then
		return true
	end
	if kind == "BasePart" then
		local anchored = true
		pcall(function()
			anchored = obj.Anchored
		end)
		return not anchored
	end
	return false
end

function getTrackKind(obj)
	if isLightingReplayObject(obj) and #getPropertyList(obj) > 0 then
		return "Props"
	elseif obj:IsA("BasePart") then
		return "BasePart"
	elseif obj:IsA("Decal") or obj:IsA("Texture") then
		return "Decal"
	elseif obj:IsA("Sound") then
		return "Sound"
	elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
		return "Text"
	elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Light") or obj:IsA("SurfaceGui") or obj:IsA("BillboardGui") then
		return "Enabled"
	elseif obj:IsA("JointInstance") or obj:IsA("WeldConstraint") then
		return "Props"
	end
	return nil
end

function getRecordCheckInterval(kind, obj)
	if kind == "BasePart" then
		return shouldRecordMapObjectEveryFrame(obj, kind) and 1 or RECORD_MAP_PART_INTERVAL
	elseif kind == "Decal" then
		return shouldRecordMapObjectEveryFrame(obj, kind) and 1 or RECORD_MAP_VISUAL_INTERVAL
	elseif kind == "Enabled" then
		return shouldRecordMapObjectEveryFrame(obj, kind) and 1 or RECORD_MAP_VISUAL_INTERVAL
	elseif kind == "Props" then
		if shouldRecordMapObjectEveryFrame(obj, kind) then
			return 1
		end
		return isLightingReplayObject(obj) and RECORD_LIGHTING_INTERVAL or RECORD_MAP_VISUAL_INTERVAL
	end
	return 1
end

function isStaticReplayObject(obj)
	return obj:IsA("SpecialMesh")
		or obj:IsA("BlockMesh")
		or obj:IsA("CylinderMesh")
		or obj:IsA("Decal")
		or obj:IsA("Texture")
		or obj:IsA("SurfaceAppearance")
		or obj:IsA("Shirt")
		or obj:IsA("Pants")
		or obj:IsA("ShirtGraphic")
		or obj:IsA("CharacterMesh")
		or obj:IsA("HumanoidDescription")
		or obj.ClassName == "WrapLayer"
		or obj.ClassName == "WrapTarget"
end

function normalizeCSGOperation(op)
	op = tostring(op or ""):lower()
	if op == "subtract" or op == "sub" or op == "minus" or op == "cut" then
		return "Subtract"
	elseif op == "intersect" or op == "intersection" then
		return "Intersect"
	elseif op == "main" or op == "base" then
		return "Main"
	end
	return "Union"
end

function isCSGRecipeMetadataObject(obj)
	local cur = obj
	while cur do
		if cur:IsA("Folder") and cur.Name == CSG_RECIPE_FOLDER_NAME then
			return true
		end
		cur = cur.Parent
	end
	return false
end

function getCSGRecipeFolder(obj)
	if not obj then
		return nil
	end
	local folder = obj:FindFirstChild(CSG_RECIPE_FOLDER_NAME)
	if folder and folder:IsA("Folder") then
		return folder
	end
	return nil
end

function isManifestObject(obj)
	if obj:IsDescendantOf(ReplayFolder) or obj.Name == "Terrain" or obj:IsA("Camera") then
		return false
	end
	if isCSGRecipeMetadataObject(obj) then
		return false
	end
	if isDuplicateDefaultFace(obj) then
		return false
	end
	return getTrackKind(obj) ~= nil
		or isStaticReplayObject(obj)
		or obj:IsA("Model")
		or obj:IsA("Folder")
		or obj:IsA("Accessory")
		or obj:IsA("Tool")
		or obj:IsA("Humanoid")
		or obj:IsA("Attachment")
		or obj:IsA("GuiObject")
end

function prepareReplayInstance(obj)
	if obj:IsA("BasePart") then
		obj.Anchored = true
		obj.CanCollide = false
		obj.LocalTransparencyModifier = 0
	elseif obj:IsA("Sound") then
		obj:Stop()
	elseif isReplayHiddenEffectObject and isReplayHiddenEffectObject(obj) then
		setReplayEffectActive(obj, false)
	elseif obj:IsA("Humanoid") then
		pcall(function() obj.PlatformStand = true end)
		pcall(function() obj.AutoRotate = false end)
		pcall(function() obj.BreakJointsOnDeath = false end)
		pcall(function() obj.RequiresNeck = false end)
		pcall(function() obj.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
		pcall(function()
			if obj.MaxHealth > 0 then
				obj.Health = obj.MaxHealth
			end
		end)
	end
end

function cleanClone(clone)
	for _, c in pairs(clone:GetDescendants()) do
		if isCSGRecipeMetadataObject(c) then
			c:Destroy()
		elseif c.Parent and isDuplicateDefaultFace(c) then
			c:Destroy()
		elseif c.Parent and ((c:IsA("Constraint") and not c:IsA("WeldConstraint")) or c:IsA("BodyMover") or c:IsA("Animator") or c:IsA("Script") or c:IsA("LocalScript")) then
			c:Destroy()
		elseif c.Parent then
			prepareReplayInstance(c)
		end
	end
	prepareReplayInstance(clone)
end

function removeReplayManagedVisualChildren(inst)
	for _, child in ipairs(inst:GetDescendants()) do
		if isCSGRecipeMetadataObject(child) then
			child:Destroy()
		elseif child.Parent and (child:IsA("Decal") or child:IsA("Texture")) then
			child:Destroy()
		end
	end
end

function getSiblingIndex(obj)
	local parent = obj.Parent
	if not parent then
		return 1
	end
	local index = 0
	for _, child in ipairs(parent:GetChildren()) do
		if child.Name == obj.Name and child.ClassName == obj.ClassName then
			index += 1
			if child == obj then
				return index
			end
		end
	end
	return 1
end

function getInstancePath(obj)
	local path = {}
	local cur = obj
	while cur and cur ~= game do
		table.insert(path, 1, { Name = cur.Name, ClassName = cur.ClassName, Index = getSiblingIndex(cur) })
		cur = cur.Parent
	end
	return path
end

function readCSGRecipeAttribute(obj)
	local text
	pcall(function()
		text = obj:GetAttribute(CSG_RECIPE_ATTRIBUTE)
	end)

	if type(text) == "string" and text ~= "" then
		return decodeCSGRecipeFromManifest(text)
	end

	return nil
end

function captureCSGOperand(part, index)
	local props = captureAllPackedProps(part)
	local op = part:GetAttribute("ReplayCSGOp") or part:GetAttribute("CSGOperation") or part:GetAttribute("Operation")
	local role = part:GetAttribute("ReplayCSGRole") or part:GetAttribute("CSGRole") or part:GetAttribute("Role")
	if role then
		op = role
	end

	local step = tonumber(part:GetAttribute("ReplayCSGStep") or part:GetAttribute("CSGStep") or index) or index

	return {
		ClassName = part.ClassName,
		Name = part.Name,
		Operation = normalizeCSGOperation(op),
		Step = step,
		Props = props,
		SourcePath = getInstancePath(part),
	}
end

function captureCSGRecipeFromFolder(obj)
	local folder = getCSGRecipeFolder(obj)
	if not folder then
		return nil
	end

	local operands = {}
	for _, child in ipairs(folder:GetDescendants()) do
		if child:IsA("BasePart") then
			operands[#operands + 1] = captureCSGOperand(child, #operands + 1)
		end
	end

	if #operands < 2 then
		return nil
	end

	local mainIndex = tonumber(folder:GetAttribute("ReplayCSGMainIndex") or folder:GetAttribute("MainIndex")) or nil
	if not mainIndex then
		for i, operand in ipairs(operands) do
			if normalizeCSGOperation(operand.Operation) == "Main" then
				mainIndex = i
				break
			end
		end
	end
	mainIndex = mainIndex or 1
	operands[mainIndex].Operation = "Main"

	return {
		Version = CSG_RECIPE_VERSION,
		MainIndex = mainIndex,
		Operands = operands,
		Options = {
			SplitApart = folder:GetAttribute("ReplayCSGSplitApart") == true,
			CollisionFidelity = tostring(folder:GetAttribute("ReplayCSGCollisionFidelity") or ""),
			RenderFidelity = tostring(folder:GetAttribute("ReplayCSGRenderFidelity") or ""),
		},
	}
end

function captureCSGRecipe(obj)
	if not obj or not obj:IsA("UnionOperation") then
		return nil
	end

	return readCSGRecipeAttribute(obj) or captureCSGRecipeFromFolder(obj)
end

function findInstanceByPath(path)
	if typeof(path) ~= "table" or #path == 0 then
		return nil
	end

	local first = path[1]
	local cur
	local okService, service = pcall(function()
		return game:GetService(first.ClassName)
	end)
	if okService and service and service.Name == first.Name then
		cur = service
	else
		cur = game:FindFirstChild(first.Name)
	end

	for i = 2, #path do
		if not cur then
			return nil
		end

		local entry = path[i]
		local wantedIndex = tonumber(entry.Index) or 1
		local seen = 0
		local found
		for _, child in ipairs(cur:GetChildren()) do
			if child.Name == entry.Name and child.ClassName == entry.ClassName then
				seen += 1
				if seen == wantedIndex then
					found = child
					break
				end
			end
		end
		cur = found
	end

	return cur
end

function findChildByManifest(parent, data, usedInstances)
	if not parent or typeof(data.SourcePath) ~= "table" then
		return nil
	end
	local entry = data.SourcePath[#data.SourcePath]
	if not entry then
		return nil
	end

	local wantedIndex = tonumber(entry.Index) or 1
	local seen = 0
	for _, child in ipairs(parent:GetChildren()) do
		if not usedInstances[child] and child.Name == entry.Name and child.ClassName == entry.ClassName then
			seen += 1
			if seen == wantedIndex then
				return child
			end
		end
	end

	for _, child in ipairs(parent:GetChildren()) do
		if not usedInstances[child] and child.Name == entry.Name and child.ClassName == entry.ClassName then
			return child
		end
	end

	return nil
end

function setSmoothSurfaces(part)
	for _, prop in ipairs({ "TopSurface", "BottomSurface", "FrontSurface", "BackSurface", "LeftSurface", "RightSurface" }) do
		pcall(function()
			part[prop] = Enum.SurfaceType.Smooth
		end)
	end
end

function safeDiv(a, b)
	if math.abs(b) < 0.001 then
		return 1
	end
	return a / b
end

function findManifestParentId(session, obj)
	local parent = obj.Parent
	while parent do
		local parentId = session.OrigToId[parent]
		if parentId then
			return parentId
		end
		parent = parent.Parent
	end
	return nil
end

function extractInitialState(session, obj, id)
	local props = isLightingReplayObject(obj) and captureAllPackedProps(obj) or captureProps(obj)
	local data = {
		Id = id,
		ClassName = obj.ClassName,
		Name = obj.Name,
		TrackKind = getTrackKind(obj),
		Props = props,
		ParentId = findManifestParentId(session, obj),
		SourcePath = getInstancePath(obj),
	}

	if obj:IsA("Humanoid") then
		local okRigType, rigType = pcall(function()
			return obj.RigType
		end)
		if okRigType then
			data.Props.RigType = packValue(rigType)
		end
	end

	if data.TrackKind == "BasePart" then
		data.PosScale = getReplayPositionScale(obj)
	end

	if obj:IsA("MeshPart") then
		data.MeshId = props.MeshId
		data.TextureID = props.TextureID
		local okMeshSize, meshSize = pcall(function()
			return obj.MeshSize
		end)
		if okMeshSize then
			data.MeshSize = packValue(meshSize)
		end
	end
	if obj:IsA("UnionOperation") then
		data.UsePartColor = props.UsePartColor
		data.RenderFidelity = props.RenderFidelity
		data.CollisionFidelity = props.CollisionFidelity
		data.CSGRecipe = captureCSGRecipe(obj)
	end
	if obj:IsA("SpecialMesh") then
		data.MeshId = props.MeshId
		data.TextureId = props.TextureId
		data.MeshType = props.MeshType
	end
	if obj:IsA("SurfaceAppearance") then
		data.ColorMap = props.ColorMap
		data.MetalnessMap = props.MetalnessMap
		data.NormalMap = props.NormalMap
		data.RoughnessMap = props.RoughnessMap
		data.AlphaMode = props.AlphaMode
	end

	local refs = {}
	if obj:IsA("Trail") or obj:IsA("Beam") then
		if obj.Attachment0 and session.OrigToId[obj.Attachment0] then
			refs.Attachment0Id = session.OrigToId[obj.Attachment0]
		end
		if obj.Attachment1 and session.OrigToId[obj.Attachment1] then
			refs.Attachment1Id = session.OrigToId[obj.Attachment1]
		end
	end
	if obj:IsA("SurfaceGui") or obj:IsA("BillboardGui") then
		local ok, adornee = pcall(function()
			return obj.Adornee
		end)
		if ok and adornee and session.OrigToId[adornee] then
			refs.AdorneeId = session.OrigToId[adornee]
		end
	end
	if obj:IsA("JointInstance") or obj:IsA("WeldConstraint") then
		local ok0, part0 = pcall(function()
			return obj.Part0
		end)
		if ok0 and part0 and session.OrigToId[part0] then
			refs.Part0Id = session.OrigToId[part0]
		end

		local ok1, part1 = pcall(function()
			return obj.Part1
		end)
		if ok1 and part1 and session.OrigToId[part1] then
			refs.Part1Id = session.OrigToId[part1]
		end
	end
	if next(refs) then
		data.Refs = refs
	end

	return data
end

function applyReferences(inst, data, idToInstance)
	local refs = data.Refs
	if typeof(refs) ~= "table" then
		return
	end
	if refs.Attachment0Id and idToInstance[tonumber(refs.Attachment0Id)] then
		pcall(function() inst.Attachment0 = idToInstance[tonumber(refs.Attachment0Id)] end)
	end
	if refs.Attachment1Id and idToInstance[tonumber(refs.Attachment1Id)] then
		pcall(function() inst.Attachment1 = idToInstance[tonumber(refs.Attachment1Id)] end)
	end
	if refs.AdorneeId and idToInstance[tonumber(refs.AdorneeId)] then
		pcall(function() inst.Adornee = idToInstance[tonumber(refs.AdorneeId)] end)
	end
	if refs.Part0Id and idToInstance[tonumber(refs.Part0Id)] then
		pcall(function() inst.Part0 = idToInstance[tonumber(refs.Part0Id)] end)
	end
	if refs.Part1Id and idToInstance[tonumber(refs.Part1Id)] then
		pcall(function() inst.Part1 = idToInstance[tonumber(refs.Part1Id)] end)
	end
end

function registerTree(root)
	if not currentSession or not root or root:IsDescendantOf(ReplayFolder) then
		return
	end

	local allOrigs = { root }
	local scanIndex = 1
	while scanIndex <= #allOrigs do
		local obj = allOrigs[scanIndex]
		scanIndex += 1
		for _, child in ipairs(obj:GetChildren()) do
			allOrigs[#allOrigs + 1] = child
		end
		if scanIndex % RECORD_REGISTER_BATCH_SIZE == 0 then
			task.wait()
			if not isRecording or not currentSession then
				return
			end
		end
	end

	local hasManifestObject = false
	for _, obj in ipairs(allOrigs) do
		if isManifestObject(obj) then
			hasManifestObject = true
			break
		end
	end
	if not hasManifestObject then
		return
	end

	if RECORD_MANIFEST_ONLY_REGISTRATION then
		currentSession.RegisteredRoots = currentSession.RegisteredRoots or {}
		currentSession.RegisteredRoots[root] = true

		for i, obj in ipairs(allOrigs) do
			if isManifestObject(obj) and not currentSession.OrigToId[obj] then
				local id = currentSession.NextId
				currentSession.NextId += 1
				currentSession.OrigToId[obj] = id
			end
			if i % RECORD_REGISTER_BATCH_SIZE == 0 then
				task.wait()
				if not isRecording or not currentSession then
					return
				end
			end
		end

		for i, obj in ipairs(allOrigs) do
			local id = currentSession.OrigToId[obj]
			if id and not currentSession.Manifest[id] then
				currentSession.Manifest[id] = extractInitialState(currentSession, obj, id)
				local kind = getTrackKind(obj)
				if kind then
					local item = {
						id = id,
						orig = obj,
						clone = nil,
						kind = kind,
						className = obj.ClassName,
						posScale = kind == "BasePart" and getReplayPositionScale(obj) or nil,
						recordInterval = getRecordCheckInterval(kind, obj),
					}
					currentSession.TrackedParts[id] = item
					currentSession.TrackedListDirty = true
					currentSession.RecordBucketsDirty = true
					setupRecordChangeSignals(currentSession, item, obj)
				end
			end
			if i % RECORD_REGISTER_BATCH_SIZE == 0 then
				task.wait()
				if not isRecording or not currentSession then
					return
				end
			end
		end

		return
	end

	local archStates = {}
	local function setArchivable(obj)
		archStates[obj] = obj.Archivable
		obj.Archivable = true
		for _, child in ipairs(obj:GetChildren()) do
			setArchivable(child)
		end
	end
	pcall(function()
		setArchivable(root)
	end)

	local tagPrefix = "Rep_" .. tostring(os.clock()) .. "_" .. tostring(math.random(1000, 9999)) .. "_"
	for i, obj in ipairs(allOrigs) do
		pcall(function()
			obj:SetAttribute("RepTag", tagPrefix .. i)
		end)
	end

	local okClone, rootClone = pcall(function()
		return root:Clone()
	end)

	for obj, state in pairs(archStates) do
		pcall(function()
			obj.Archivable = state
		end)
	end

	if not okClone or not rootClone then
		for _, obj in ipairs(allOrigs) do
			pcall(function()
				obj:SetAttribute("RepTag", nil)
			end)
		end
		return
	end

	local cloneDesc = { rootClone }
	for _, c in ipairs(rootClone:GetDescendants()) do
		cloneDesc[#cloneDesc + 1] = c
	end

	local cloneDict = {}
	for _, c in ipairs(cloneDesc) do
		local tag = c:GetAttribute("RepTag")
		if tag then
			cloneDict[tag] = c
		end
		c:SetAttribute("RepTag", nil)
	end

	for _, obj in ipairs(allOrigs) do
		local tag = obj:GetAttribute("RepTag")
		local clone = tag and cloneDict[tag]
		if clone and isDuplicateDefaultFace(obj) then
			clone:Destroy()
			clone = nil
		end
		if clone then
			currentSession.OrigToClone[obj] = clone
		end
		if clone and isManifestObject(obj) and not currentSession.OrigToId[obj] then
			local id = currentSession.NextId
			currentSession.NextId += 1
			currentSession.OrigToId[obj] = id
		end
	end

	for _, obj in ipairs(allOrigs) do
		local id = currentSession.OrigToId[obj]
		local clone = currentSession.OrigToClone[obj]
		if id and clone and not currentSession.Manifest[id] then
			currentSession.Manifest[id] = extractInitialState(currentSession, obj, id)
			local kind = getTrackKind(obj)
			if kind then
				local item = {
					id = id,
					orig = obj,
					clone = clone,
					kind = kind,
					className = obj.ClassName,
					posScale = kind == "BasePart" and getReplayPositionScale(obj) or nil,
					recordInterval = getRecordCheckInterval(kind, obj),
				}
				currentSession.TrackedParts[id] = item
				currentSession.TrackedListDirty = true
				currentSession.RecordBucketsDirty = true
				setupRecordChangeSignals(currentSession, item, obj)
			end
		end
		pcall(function()
			obj:SetAttribute("RepTag", nil)
		end)
	end

	local parentClone = root.Parent and currentSession.OrigToClone[root.Parent]
	if parentClone then
		rootClone.Parent = parentClone
	else
		currentSession.RootClones[root] = rootClone
	end
	cleanClone(rootClone)
end

function registerLightingObject(obj)
	if not isRecording or not currentSession or not obj or not isLightingReplayObject(obj) then
		return
	end
	if obj ~= Lighting and not shouldCaptureLightingChild(obj) then
		return
	end

	local parent = obj.Parent
	if parent and isLightingReplayObject(parent) and not currentSession.OrigToId[parent] then
		registerLightingObject(parent)
	end

	if currentSession.OrigToId[obj] or not isManifestObject(obj) then
		return
	end

	local id = currentSession.NextId
	currentSession.NextId += 1
	currentSession.OrigToId[obj] = id
	currentSession.Manifest[id] = extractInitialState(currentSession, obj, id)

	local kind = getTrackKind(obj)
	if kind then
		local item = {
			id = id,
			orig = obj,
			clone = nil,
			kind = kind,
			className = obj.ClassName,
			recordInterval = getRecordCheckInterval(kind, obj),
		}
		currentSession.TrackedParts[id] = item
		currentSession.TrackedListDirty = true
		currentSession.RecordBucketsDirty = true
		setupRecordChangeSignals(currentSession, item, obj)
	end
end

function registerLightingTree(root)
	if not isRecording or not currentSession or not root then
		return
	end
	if root ~= Lighting and not root:IsDescendantOf(Lighting) then
		return
	end

	registerLightingObject(root)
	for _, obj in ipairs(root:GetDescendants()) do
		registerLightingObject(obj)
	end
end

function retireTrackedTree(session, root)
	if not session or not root then
		return
	end

	session.RetiredRoots = session.RetiredRoots or {}
	session.RetiredRoots[root] = true

	for _, item in pairs(session.TrackedParts or {}) do
		local orig = item.orig
		if orig == root or (orig and orig:IsDescendantOf(root)) then
			item.retired = true
			item.recordInterval = 1
			markRecordItemDirty(session, item)
		end
	end
	session.RecordBucketsDirty = true
end

function isLocalCharacterRoot(root)
	if not root or not root:IsA("Model") or not root:FindFirstChildOfClass("Humanoid") then
		return false
	end
	return root == player.Character or Players:GetPlayerFromCharacter(root) == player
end

function isStaleLocalCharacterRoot(root)
	if not root or not root:IsA("Model") or not root:FindFirstChildOfClass("Humanoid") then
		return false
	end
	if root == player.Character or Players:GetPlayerFromCharacter(root) == player then
		return false
	end
	return root.Name == player.Name
end

function updateLocalRecordingCharacterRoot(root)
	if not isRecording or not currentSession or not isLocalCharacterRoot(root) then
		return
	end

	local previousRoot = currentSession.LocalCharacterRoot
	if previousRoot and previousRoot ~= root then
		retireTrackedTree(currentSession, previousRoot)
	end

	currentSession.LocalCharacterRoot = root
end

function getCharacterSizeSignature(character)
	local count = 0
	local signature = 0
	for _, obj in ipairs(character:GetDescendants()) do
		if obj:IsA("BasePart") then
			count += 1
			signature += obj.Size.X * 31 + obj.Size.Y * 17 + obj.Size.Z * 13
		end
	end
	return count, signature
end

function waitForCharacterStable(character)
	if not character then
		return false
	end

	local deadline = os.clock() + CHARACTER_REGISTER_TIMEOUT
	local humanoid
	local rootPart
	pcall(function()
		humanoid = character:WaitForChild("Humanoid", CHARACTER_REGISTER_TIMEOUT)
	end)
	pcall(function()
		rootPart = character:WaitForChild("HumanoidRootPart", CHARACTER_REGISTER_TIMEOUT)
	end)

	local stableFrames = 0
	local lastSignature
	while os.clock() < deadline and character.Parent do
		RunService.Heartbeat:Wait()

		local count, signature = getCharacterSizeSignature(character)
		local hasRoot = rootPart and rootPart.Parent == character and rootPart:IsA("BasePart")
		local hasHumanoid = humanoid and humanoid.Parent == character
		if hasRoot and hasHumanoid and count >= 2 then
			if lastSignature and math.abs(signature - lastSignature) <= 0.001 then
				stableFrames += 1
			else
				stableFrames = 0
			end
			lastSignature = signature

			if stableFrames >= CHARACTER_REGISTER_STABLE_FRAMES then
				return true
			end
		end
	end

	return character.Parent ~= nil
end

local registerEntity

function registerCharacterWhenStable(session, character)
	if not session or not character then
		return
	end

	session.PendingCharacterRoots = session.PendingCharacterRoots or {}
	if session.PendingCharacterRoots[character] then
		return
	end
	session.PendingCharacterRoots[character] = true

	task.spawn(function()
		waitForCharacterStable(character)

		if session.PendingCharacterRoots then
			session.PendingCharacterRoots[character] = nil
		end

		if isRecording and currentSession == session and character.Parent then
			registerEntity(character)
		end
	end)
end

function registerEntity(obj)
	if not isRecording or not currentSession then
		return
	end
	if not obj or not obj.Parent then
		return
	end
	if obj:IsDescendantOf(ReplayFolder) or obj.Name == "Terrain" or obj:IsA("Camera") then
		return
	end

	local root = obj
	local modelAncestor = obj:FindFirstAncestorOfClass("Model")
	if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
		root = obj
	elseif modelAncestor and modelAncestor:FindFirstChildOfClass("Humanoid") then
		root = modelAncestor
	end

	if isLocalCharacterRoot(root) and currentSession.LocalCharacterRoot ~= root then
		local previousRoot = currentSession.LocalCharacterRoot
		if previousRoot then
			retireTrackedTree(currentSession, previousRoot)
		end
		currentSession.LocalCharacterRoot = root
		registerCharacterWhenStable(currentSession, root)
		return
	end
	if currentSession.PendingCharacterRoots and currentSession.PendingCharacterRoots[root] then
		return
	end
	if isStaleLocalCharacterRoot(root) then
		retireTrackedTree(currentSession, root)
		return
	end
	updateLocalRecordingCharacterRoot(root)

	if currentSession.RegisteredRoots and currentSession.RegisteredRoots[root] then
		if not currentSession.OrigToId[obj] and isManifestObject(obj) then
			registerTree(obj)
		end
		return
	end

	if currentSession.OrigToClone[root] then
		if not currentSession.OrigToClone[obj] and isManifestObject(obj) then
			registerTree(obj)
		end
		return
	end

	registerTree(root)
end

function getTrackedList(session)
	if not session then
		return {}
	end

	if session.TrackedList and not session.TrackedListDirty then
		return session.TrackedList
	end

	local list = {}
	for id, item in pairs(session.TrackedParts or {}) do
		item.id = item.id or id
		list[#list + 1] = item
	end

	table.sort(list, function(a, b)
		return (a.id or 0) < (b.id or 0)
	end)

	session.TrackedList = list
	session.TrackedListDirty = false
	return list
end

function shouldRecordItemOnFrame(session, item, frameIndex)
	if not session or not item then
		return false
	end
	if item.forceRecordUntilFrame and frameIndex <= item.forceRecordUntilFrame then
		return true
	end
	if session.LastState and session.LastState[item.id] == nil then
		return true
	end

	local interval = tonumber(item.recordInterval) or 1
	if interval <= 1 then
		return true
	end

	if item.recordOffset == nil then
		item.recordOffset = (tonumber(item.id) or 0) % interval
	end

	return frameIndex % interval == item.recordOffset
end

function queueInitialRecordItem(session, item)
	if not session or not item then
		return
	end
	session.PendingInitialRecordItems = session.PendingInitialRecordItems or {}
	session.PendingInitialRecordItems[item] = true
end

function markRecordItemDirty(session, item)
	if not session or not item then
		return
	end
	if item.orig and item.kind then
		local nextInterval = getRecordCheckInterval(item.kind, item.orig)
		if nextInterval ~= item.recordInterval then
			item.recordInterval = nextInterval
			session.RecordBucketsDirty = true
		end
	end
	local untilFrame = (session.RecordFrameIndex or 0) + RECORD_DYNAMIC_PROMOTE_FRAMES
	item.forceRecordUntilFrame = math.max(item.forceRecordUntilFrame or 0, untilFrame)
	session.DirtyRecordItems = session.DirtyRecordItems or {}
	session.DirtyRecordItems[item] = true
end

function markTrackedObjectDirty(session, obj)
	if not session or not obj then
		return
	end
	local id = session.OrigToId and session.OrigToId[obj]
	local item = id and session.TrackedParts and session.TrackedParts[id]
	if item then
		markRecordItemDirty(session, item)
	end
end

function addRecordSignal(session, conn)
	if not session or not conn then
		return
	end
	session.RecordChangeConnections = session.RecordChangeConnections or {}
	table.insert(session.RecordChangeConnections, conn)
end

function disconnectRecordChangeSignals(session)
	if not session then
		return
	end
	for _, conn in ipairs(session.RecordChangeConnections or {}) do
		if conn then
			pcall(function()
				conn:Disconnect()
			end)
		end
	end
	session.RecordChangeConnections = {}
	session.DirtyRecordItems = {}
	session.PendingInitialRecordItems = {}
	session.RecordBuckets = nil
	session.RecordAlwaysList = nil
	session.RecordBucketIntervals = nil
	session.RecordBucketsDirty = true
end

function watchRecordProperty(session, item, obj, prop)
	if not session or not item or not obj or not prop then
		return
	end
	local ok, signal = pcall(function()
		return obj:GetPropertyChangedSignal(prop)
	end)
	if ok and signal then
		addRecordSignal(session, signal:Connect(function()
			if isRecording and currentSession == session then
				markRecordItemDirty(session, item)
			end
		end))
	end
end

function watchRecordProperties(session, item, obj, props)
	if not session or not item or not obj or not props then
		return
	end

	local watched = {}
	for _, prop in ipairs(props) do
		watched[prop] = true
	end

	local ok, changedSignal = pcall(function()
		return obj.Changed
	end)
	if ok and changedSignal then
		addRecordSignal(session, changedSignal:Connect(function(prop)
			if watched[prop] and isRecording and currentSession == session then
				markRecordItemDirty(session, item)
			end
		end))
	else
		for _, prop in ipairs(props) do
			watchRecordProperty(session, item, obj, prop)
		end
	end
end

function setupRecordChangeSignals(session, item, obj)
	if not session or not item or not obj then
		return
	end

	queueInitialRecordItem(session, item)

	if item.kind == "BasePart" then
		watchRecordProperties(session, item, obj, { "CFrame", "Position", "Orientation", "Size", "Color", "Transparency", "Anchored" })
	elseif item.kind == "Decal" then
		watchRecordProperties(session, item, obj, { "Texture", "Color3", "Transparency", "LocalTransparencyModifier" })
	elseif item.kind == "Enabled" then
		watchRecordProperties(session, item, obj, { "Enabled" })
	elseif item.kind == "Props" and not isCharacterObject(obj) then
		watchRecordProperties(session, item, obj, getPropertyList(obj))
	end
end

function addFrameRecordItem(target, seen, item)
	if item and not seen[item] then
		seen[item] = true
		target[#target + 1] = item
	end
end

function buildRecordBuckets(session)
	local list = getTrackedList(session)
	local always = {}
	local buckets = {}
	local intervals = {}

	for _, item in ipairs(list) do
		local interval = tonumber(item.recordInterval) or 1
		if interval <= 1 then
			always[#always + 1] = item
		else
			interval = math.max(2, math.floor(interval))
			local offset = item.recordOffset
			if offset == nil or offset >= interval or item.recordOffsetInterval ~= interval then
				offset = (tonumber(item.id) or 0) % interval
				item.recordOffset = offset
				item.recordOffsetInterval = interval
			end
			if not buckets[interval] then
				buckets[interval] = {}
				intervals[#intervals + 1] = interval
			end
			local intervalBuckets = buckets[interval]
			intervalBuckets[offset] = intervalBuckets[offset] or {}
			table.insert(intervalBuckets[offset], item)
		end
	end

	session.RecordAlwaysList = always
	session.RecordBuckets = buckets
	session.RecordBucketIntervals = intervals
	session.RecordBucketSourceSize = #list
	session.RecordBucketsDirty = false
end

function getRecordItemsForFrame(session, frameIndex)
	local trackedList = getTrackedList(session)
	if not session.RecordBuckets or session.RecordBucketsDirty or session.RecordBucketSourceSize ~= #trackedList then
		buildRecordBuckets(session)
	end

	local result = session.RecordFrameScratch or {}
	for i = #result, 1, -1 do
		result[i] = nil
	end
	session.RecordFrameScratch = result

	local seen = session.RecordFrameSeen or {}
	for item in pairs(seen) do
		seen[item] = nil
	end
	session.RecordFrameSeen = seen

	for _, item in ipairs(session.RecordAlwaysList or {}) do
		addFrameRecordItem(result, seen, item)
	end

	for _, interval in ipairs(session.RecordBucketIntervals or {}) do
		local bucket = session.RecordBuckets[interval]
		local scheduled = bucket and bucket[frameIndex % interval]
		if scheduled then
			for _, item in ipairs(scheduled) do
				addFrameRecordItem(result, seen, item)
			end
		end
	end

	for item in pairs(session.PendingInitialRecordItems or {}) do
		addFrameRecordItem(result, seen, item)
		session.PendingInitialRecordItems[item] = nil
	end

	for item in pairs(session.DirtyRecordItems or {}) do
		if item.forceRecordUntilFrame and frameIndex <= item.forceRecordUntilFrame then
			addFrameRecordItem(result, seen, item)
		else
			session.DirtyRecordItems[item] = nil
		end
	end

	return result
end

function registerDescendantsBatched(root, callback)
	local queue = root:GetChildren()
	local index = 1
	local processed = 0

	while index <= #queue do
		if not isRecording or not currentSession then
			return
		end

		local obj = queue[index]
		index += 1
		processed += 1

		callback(obj)

		local skipChildren = currentSession
			and (
				(currentSession.OrigToClone and currentSession.OrigToClone[obj] ~= nil)
				or (currentSession.RegisteredRoots and currentSession.RegisteredRoots[obj] ~= nil)
			)

		if not skipChildren then
			for _, child in ipairs(obj:GetChildren()) do
				queue[#queue + 1] = child
			end
		end

		if processed % RECORD_REGISTER_BATCH_SIZE == 0 then
			task.wait()
		end
	end
end

function sortedManifestEntries(manifest)
	local entries = {}
	for id, data in pairs(manifest or {}) do
		local numericId = tonumber(id) or tonumber(data.Id)
		if numericId and typeof(data) == "table" then
			entries[#entries + 1] = { id = numericId, data = data }
		end
	end
	table.sort(entries, function(a, b)
		return a.id < b.id
	end)
	return entries
end

function getManifestData(session, id)
	if not session or not session.Manifest then
		return nil
	end
	return session.Manifest[id] or session.Manifest[tostring(id)]
end

function manifestHeadHasTexturedMesh(session, headId)
	local headData = getManifestData(session, headId)
	if typeof(headData) ~= "table" or headData.Name ~= "Head" then
		return false
	end

	local headProps = headData.Props or {}
	if headData.ClassName == "MeshPart" then
		local textureId = getRawProp(headProps, "TextureID") or headData.TextureID
		if not isBlankContentId(textureId) then
			return true
		end
	end

	for _, entry in ipairs(sortedManifestEntries(session.Manifest)) do
		local data = entry.data
		if tonumber(data.ParentId) == tonumber(headId) then
			if data.ClassName == "SpecialMesh" then
				local textureId = getRawProp(data.Props, "TextureId") or data.TextureId
				if not isBlankContentId(textureId) then
					return true
				end
			elseif data.ClassName == "SurfaceAppearance" then
				local colorMap = getRawProp(data.Props, "ColorMap") or data.ColorMap
				if not isBlankContentId(colorMap) then
					return true
				end
			end
		end
	end

	return false
end

function shouldSkipManifestFace(session, data)
	if typeof(data) ~= "table" then
		return false
	end
	if data.ClassName ~= "Decal" and data.ClassName ~= "Texture" then
		return false
	end
	if string.lower(tostring(data.Name or "")) ~= "face" then
		return false
	end
	local parentId = tonumber(data.ParentId)
	if not parentId then
		return false
	end
	return manifestHeadHasTexturedMesh(session, parentId)
end

function isLightingManifestData(data)
	if typeof(data) ~= "table" then
		return false
	end
	if data.ClassName == "Lighting" then
		return true
	end
	local path = data.SourcePath
	local first = typeof(path) == "table" and path[1] or nil
	return typeof(first) == "table" and first.ClassName == "Lighting"
end

function canParentReplayInstance(inst, parent)
	if inst and inst:IsA("SurfaceAppearance") then
		return parent ~= nil and parent:IsA("MeshPart")
	end
	return true
end

function getEnumByName(enumType, value)
	if typeof(value) == "EnumItem" then
		return value
	end

	local name = tostring(value or "")
	if name == "" then
		return nil
	end

	local enumItem
	pcall(function()
		enumItem = enumType[name]
	end)
	return enumItem
end

function decodeCSGOptions(optionsData)
	local options = {
		SplitApart = false,
	}
	if typeof(optionsData) ~= "table" then
		return options
	end

	options.SplitApart = optionsData.SplitApart == true

	local collision = getEnumByName(Enum.CollisionFidelity, optionsData.CollisionFidelity)
	if collision then
		options.CollisionFidelity = collision
	end

	local render = getEnumByName(Enum.RenderFidelity, optionsData.RenderFidelity)
	if render then
		options.RenderFidelity = render
	end

	return options
end

function createCSGOperandInstance(operand)
	if typeof(operand) ~= "table" then
		return nil
	end

	local props = operand.Props or {}
	local source = findInstanceByPath(operand.SourcePath)
	if source and source:IsA("BasePart") then
		local clone = source:Clone()
		clone.Name = operand.Name or source.Name
		removeReplayManagedVisualChildren(clone)
		applyProps(clone, props)
		prepareReplayInstance(clone)
		return clone
	end

	local className = tostring(operand.ClassName or "Part")
	local ok, inst = pcall(function()
		return Instance.new(className)
	end)
	if not ok or not inst or not inst:IsA("BasePart") then
		if inst then
			inst:Destroy()
		end
		inst = Instance.new("Part")
		className = "Part"
	end

	inst.Name = operand.Name or className
	applyDefaultPropsForSkipped(inst, className, props)
	applyProps(inst, props)
	prepareReplayInstance(inst)
	return inst
end

function runCSGOperation(mainPart, otherParts, operation, options)
	local op = normalizeCSGOperation(operation)
	if not mainPart or #otherParts == 0 then
		return mainPart
	end

	local ok, result = pcall(function()
		if op == "Subtract" then
			return GeometryService:SubtractAsync(mainPart, otherParts, options)
		elseif op == "Intersect" then
			return GeometryService:IntersectAsync(mainPart, otherParts, options)
		end
		return GeometryService:UnionAsync(mainPart, otherParts, options)
	end)

	if not ok or not result then
		return nil
	end

	if typeof(result) == "table" then
		for i = 2, #result do
			if result[i] then
				result[i]:Destroy()
			end
		end
		return result[1]
	elseif typeof(result) == "Instance" then
		return result
	end

	return nil
end

function buildImplicitCSGSteps(operands, mainIndex)
	local steps = {}
	for i, operand in ipairs(operands or {}) do
		if i ~= mainIndex then
			steps[#steps + 1] = {
				Operation = normalizeCSGOperation(operand.Operation),
				Parts = { i },
				Step = tonumber(operand.Step) or i,
			}
		end
	end
	table.sort(steps, function(a, b)
		if (a.Step or 0) == (b.Step or 0) then
			return tostring(a.Operation or "") < tostring(b.Operation or "")
		end
		return (a.Step or 0) < (b.Step or 0)
	end)
	return steps
end

function buildUnionFromCSGRecipe(recipe, finalProps, finalName)
	if typeof(recipe) ~= "table" then
		return nil
	end

	local operands = recipe.Operands or recipe.Parts
	if typeof(operands) ~= "table" or #operands < 2 then
		return nil
	end

	local created = {}
	for i, operand in ipairs(operands) do
		created[i] = createCSGOperandInstance(operand)
	end

	local mainIndex = tonumber(recipe.MainIndex) or 1
	local mainPart = created[mainIndex]
	if not mainPart then
		for _, part in pairs(created) do
			if part then
				part:Destroy()
			end
		end
		return nil
	end

	local options = decodeCSGOptions(recipe.Options)
	local steps = recipe.Steps
	if typeof(steps) ~= "table" or #steps == 0 then
		steps = buildImplicitCSGSteps(operands, mainIndex)
	end

	for _, step in ipairs(steps) do
		local otherParts = {}
		local usedIndexes = {}
		for _, partIndex in ipairs(step.Parts or step.Operands or {}) do
			local numericIndex = tonumber(partIndex)
			local part = numericIndex and created[numericIndex]
			if part and part ~= mainPart then
				otherParts[#otherParts + 1] = part
				usedIndexes[#usedIndexes + 1] = numericIndex
			end
		end

		local nextMain = runCSGOperation(mainPart, otherParts, step.Operation or step.Op or step.Type, options)
		if not nextMain then
			for _, part in pairs(created) do
				if part then
					part:Destroy()
				end
			end
			if mainPart then
				mainPart:Destroy()
			end
			return nil
		end

		if mainPart ~= nextMain then
			mainPart:Destroy()
		end
		mainPart = nextMain
		for _, usedIndex in ipairs(usedIndexes) do
			if created[usedIndex] then
				created[usedIndex]:Destroy()
				created[usedIndex] = nil
			end
		end
		created[mainIndex] = mainPart
	end

	for _, part in pairs(created) do
		if part and part ~= mainPart then
			part:Destroy()
		end
	end

	mainPart.Name = finalName or "RebuiltUnionOperation"
	applyProps(mainPart, finalProps)
	cleanClone(mainPart)
	return mainPart
end

function createLoadedInstance(data)
	local props = data.Props or {}

	if data.ClassName == "UnionOperation" then
		local source = findInstanceByPath(data.SourcePath)
		if source and source:IsA("UnionOperation") then
			local clone = source:Clone()
			clone.Name = data.Name or source.Name
			removeReplayManagedVisualChildren(clone)
			applyProps(clone, props)
			cleanClone(clone)
			return clone, nil, false, true
		end

		local rebuilt = buildUnionFromCSGRecipe(data.CSGRecipe, props, data.Name)
		if rebuilt then
			return rebuilt, nil, false, false
		end

		local part = Instance.new("Part")
		part.Name = data.Name or "MissingUnionOperation"
		setSmoothSurfaces(part)
		applyProps(part, props, {
			UsePartColor = true,
			RenderFidelity = true,
			CollisionFidelity = true,
		})
		prepareReplayInstance(part)
		return part, nil, false, false
	end

	if data.ClassName == "MeshPart" then
		local source = findInstanceByPath(data.SourcePath)
		if source and source:IsA("MeshPart") then
			local clone = source:Clone()
			clone.Name = data.Name or source.Name
			removeReplayManagedVisualChildren(clone)
			applyDefaultPropsForSkipped(clone, data.ClassName, props, { MeshId = true, MeshContent = true, TextureContent = true })
			applyProps(clone, props, { MeshId = true, MeshContent = true, TextureContent = true })
			cleanClone(clone)
			return clone, nil, false, true
		end

		local part = Instance.new("Part")
		part.Name = data.Name or "MissingMeshPart"
		setSmoothSurfaces(part)
		applyProps(part, props, {
			MeshId = true,
			MeshContent = true,
			TextureContent = true,
			TextureID = true,
			TopSurface = true,
			BottomSurface = true,
			FrontSurface = true,
			BackSurface = true,
			LeftSurface = true,
			RightSurface = true,
		})

		local mesh = Instance.new("SpecialMesh")
		mesh.Name = "MeshPartFallbackMesh"
		mesh.MeshType = Enum.MeshType.FileMesh
		mesh.MeshId = tostring(getRawProp(props, "MeshId") or data.MeshId or "")
		mesh.TextureId = tostring(getRawProp(props, "TextureID") or data.TextureID or "")
		mesh.Parent = part

		local wantedSize = getRawProp(props, "Size") or Vector3.new(1, 1, 1)
		local meshSize = unpackValue(data.MeshSize)
		if typeof(meshSize) == "Vector3" then
			part.Size = Vector3.new(math.max(meshSize.X, 0.05), math.max(meshSize.Y, 0.05), math.max(meshSize.Z, 0.05))
			mesh.Scale = Vector3.new(safeDiv(wantedSize.X, part.Size.X), safeDiv(wantedSize.Y, part.Size.Y), safeDiv(wantedSize.Z, part.Size.Z))
		else
			part.Size = Vector3.new(1, 1, 1)
			mesh.Scale = wantedSize
		end

		prepareReplayInstance(part)
		return part, mesh, true, false
	end

	if data.ClassName == "SurfaceAppearance" then
		local source = findInstanceByPath(data.SourcePath)
		local inst
		if source and source:IsA("SurfaceAppearance") then
			inst = source:Clone()
			inst.Name = data.Name or source.Name
		else
			inst = Instance.new("SurfaceAppearance")
			inst.Name = data.Name or "SurfaceAppearance"
		end
		applyDefaultPropsForSkipped(inst, data.ClassName, props)
		applyProps(inst, props)
		return inst, nil, false, source ~= nil
	end

	local ok, inst = pcall(function()
		return Instance.new(data.ClassName)
	end)
	if not ok or not inst then
		return nil
	end

	inst.Name = data.Name or data.ClassName
	applyProps(inst, props)
	prepareReplayInstance(inst)
	return inst, nil, false, false
end

function buildLoadedReplay(session)
	if session.BuiltFromManifest then
		return true
	end

	session.TrackedParts = {}
	session.TrackedList = {}
	session.TrackedListDirty = true
	session.RootClones = {}
	session.OrigToClone = {}
	session.IdToClone = {}

	local idToInstance = session.IdToClone
	local usedInstances = {}
	local entries = sortedManifestEntries(session.Manifest)

	for _, entry in ipairs(entries) do
		local id = entry.id
		local data = entry.data
		if not isLightingManifestData(data) and not shouldSkipManifestFace(session, data) then
			local parentId = tonumber(data.ParentId)
			local parent = parentId and idToInstance[parentId]
			local inst = parent and findChildByManifest(parent, data, usedInstances)
			local meshVisual, meshFallback = nil, false

			if inst then
				usedInstances[inst] = true
				applyDefaultPropsForSkipped(inst, data.ClassName, data.Props)
				applyProps(inst, data.Props)
				prepareReplayInstance(inst)
			else
				local sourceCloned
				inst, meshVisual, meshFallback, sourceCloned = createLoadedInstance(data)
				if inst then
					usedInstances[inst] = true
					if sourceCloned then
						for _, d in ipairs(inst:GetDescendants()) do
							usedInstances[d] = false
						end
					end
				end
			end

			if inst and not canParentReplayInstance(inst, parent) then
				inst:Destroy()
				inst = nil
			end

			if inst then
				idToInstance[id] = inst
				if data.TrackKind then
					session.TrackedParts[id] = {
						id = id,
						orig = nil,
						clone = inst,
						kind = data.TrackKind,
						className = data.ClassName,
						posScale = tonumber(data.PosScale) or POS_SCALE,
						meshFallback = meshFallback,
						meshVisual = meshVisual,
						meshBaseSize = meshFallback and inst.Size or nil,
					}
				end
			end
		end
	end
	session.TrackedListDirty = true

	for _, entry in ipairs(entries) do
		local inst = idToInstance[entry.id]
		if inst then
			applyReferences(inst, entry.data, idToInstance)
		end
	end

	for _, entry in ipairs(entries) do
		local id = entry.id
		local data = entry.data
		local inst = idToInstance[id]
		if inst then
			local parentId = tonumber(data.ParentId)
			local parent = parentId and idToInstance[parentId]
			if parent and inst.Parent ~= parent then
				if canParentReplayInstance(inst, parent) then
					inst.Parent = parent
				end
			elseif not parent then
				if canParentReplayInstance(inst, nil) then
					table.insert(session.RootClones, inst)
				end
			end
		end
	end

	session.BuiltFromManifest = true
	return true
end

function buildReplayLighting(session)
	if not session or not session.Manifest then
		return
	end

	local entries = sortedManifestEntries(session.Manifest)
	local hasLightingData = false
	for _, entry in ipairs(entries) do
		if isLightingManifestData(entry.data) then
			hasLightingData = true
			break
		end
	end
	if not hasLightingData then
		return
	end

	restoreReplayLighting()

	local originalChildren = Lighting:GetChildren()
	local lightingIdToInstance = {}
	local createdChildren = {}
	session.LightingIdToInstance = lightingIdToInstance

	lightingRestoreState = {
		Props = captureAllPackedProps(Lighting),
		HiddenChildren = {},
		CreatedChildren = createdChildren,
	}

	for _, entry in ipairs(entries) do
		local id = entry.id
		local data = entry.data
		if isLightingManifestData(data) then
			local inst
			if data.ClassName == "Lighting" then
				inst = Lighting
			else
				local ok
				ok, inst = pcall(function()
					return Instance.new(data.ClassName)
				end)
				if ok and inst then
					inst.Name = data.Name or data.ClassName
					applyProps(inst, data.Props)
					table.insert(createdChildren, inst)
				else
					inst = nil
				end
			end

			if inst then
				lightingIdToInstance[id] = inst
				if data.TrackKind then
					local item = session.TrackedParts[id]
					if not item then
						item = {
							id = id,
							orig = nil,
							kind = data.TrackKind,
							className = data.ClassName,
						}
						session.TrackedParts[id] = item
					end
					item.clone = inst
					item.kind = data.TrackKind
					item.id = id
					item.replayParent = nil
					item.replayParentId = tonumber(data.ParentId)
				end
			end
		end
	end

	local parentedCount = 0
	for _, entry in ipairs(entries) do
		local inst = lightingIdToInstance[entry.id]
		local data = entry.data
		if inst and inst ~= Lighting and isLightingManifestData(data) then
			local parent = tonumber(data.ParentId) and lightingIdToInstance[tonumber(data.ParentId)] or Lighting
			pcall(function()
				inst.Parent = parent or Lighting
			end)
			local item = session.TrackedParts[entry.id]
			if item then
				item.replayParent = parent or Lighting
				item.replayParentId = tonumber(data.ParentId)
			end
			if inst.Parent then
				parentedCount += 1
			end
		end
	end

	if parentedCount > 0 then
		for _, child in ipairs(originalChildren) do
			if child and child.Parent == Lighting then
				table.insert(lightingRestoreState.HiddenChildren, child)
				child.Parent = nil
			end
		end
	else
		for i = #createdChildren, 1, -1 do
			local child = createdChildren[i]
			if child then
				child:Destroy()
			end
		end
		lightingRestoreState.CreatedChildren = {}
	end

	session.TrackedListDirty = true
end

function pulseReplayAppearanceObject(obj)
	local parent = obj and obj.Parent
	if not parent then
		return
	end

	pcall(function()
		obj.Parent = nil
		obj.Parent = parent
	end)
end

function modelHasReplayAppearanceData(model)
	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("Shirt")
			or obj:IsA("Pants")
			or obj:IsA("ShirtGraphic")
			or obj:IsA("Accessory")
			or obj:IsA("CharacterMesh") then
			return true
		end
	end

	return false
end

function refreshReplayHumanoidAppearance(model)
	if not model or not model:IsA("Model") or not modelHasReplayAppearanceData(model) then
		return
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	task.defer(function()
		if not model.Parent or not humanoid.Parent then
			return
		end

		pulseReplayAppearanceObject(humanoid)

		for _, child in ipairs(model:GetChildren()) do
			if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") then
				pulseReplayAppearanceObject(child)
			end
		end

		prepareReplayInstance(humanoid)
	end)
end

function refreshReplayHumanoidAppearances(session)
	local seen = {}

	for _, root in pairs((session and session.RootClones) or {}) do
		if root then
			if root:IsA("Model") and root:FindFirstChildOfClass("Humanoid") and not seen[root] then
				seen[root] = true
				refreshReplayHumanoidAppearance(root)
			end

			for _, obj in ipairs(root:GetDescendants()) do
				if obj:IsA("Humanoid") then
					local model = obj.Parent
					if model and model:IsA("Model") and not seen[model] then
						seen[model] = true
						refreshReplayHumanoidAppearance(model)
					end
				end
			end
		end
	end
end

function enforceGuisHidden()
	if not isReplayMode then
		return
