UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end
	if isReplayMode then
		if input.KeyCode == Enum.KeyCode.Space then
			togglePlayPause()
		elseif numberKeybinds[input.KeyCode] ~= nil then
			currentFrame = math.max(1, (numberKeybinds[input.KeyCode] * (totalFrames - 1)) + 1)
			applyFrame(currentFrame)
		end
	end
end)

RunService.RenderStepped:Connect(function(dt)
	if isReplayMode and isPlaying and not isDraggingTimeline then
		currentFrame += dt * (currentSession.ReplayFPS or REPLAY_FPS)
		if currentFrame >= totalFrames then
			currentFrame = totalFrames
			isPlaying = false
			PlayPauseBtn.Text = "▶ 재생"
			PlayPauseBtn.BackgroundColor3 = Color3.fromRGB(80, 200, 80)
			stopAllReplaySounds()
		end
		applyFrame(currentFrame)
	end
end)

TimelineBg.InputBegan:Connect(function(input)
	if isReplayMode and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		isDraggingTimeline = true
		isPlaying = false
		PlayPauseBtn.Text = "▶ 재생"
		PlayPauseBtn.BackgroundColor3 = Color3.fromRGB(80, 200, 80)
		stopAllReplaySounds()
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingTimeline = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if isDraggingTimeline and isReplayMode and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		currentFrame = math.max(1, (math.clamp((input.Position.X - TimelineBg.AbsolutePosition.X) / TimelineBg.AbsoluteSize.X, 0, 1) * (totalFrames - 1)) + 1)
		applyFrame(currentFrame)
	end
end)

