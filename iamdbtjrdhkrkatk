		or className == "Sparkles"
		or className == "Fire"
		or className == "Smoke"
		or className == "Explosion"
		or className == "Highlight"
		or className == "SelectionBox"
		or className == "SelectionSphere"
		or className == "Handles"
		or className == "ArcHandles"
		or className == "ForceField"
