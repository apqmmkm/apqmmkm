local DEFAULT_INSTANCE_CACHE = {}
local DEFAULT_PROP_CACHE = {}

local function getDefaultInstance(className)
	if DEFAULT_INSTANCE_CACHE[className] ~= nil then
		return DEFAULT_INSTANCE_CACHE[className] ~= false and DEFAULT_INSTANCE_CACHE[className] or nil
	end

	local ok, inst = pcall(function()
		return Instance.new(className)
	end)
	if ok and inst then
		DEFAULT_INSTANCE_CACHE[className] = inst
		return inst
	end

	DEFAULT_INSTANCE_CACHE[className] = false
	return nil
end

local function getDefaultPackedProperty(className, prop)
	local classCache = DEFAULT_PROP_CACHE[className]
	if not classCache then
		classCache = {}
		DEFAULT_PROP_CACHE[className] = classCache
	end

	local cached = classCache[prop]
	if cached then
		return cached.value, cached.ok
	end

	local defaultInst = getDefaultInstance(className)
	if not defaultInst then
		classCache[prop] = { ok = false }
		return nil, false
	end

	local ok, value = pcall(function()
		return defaultInst[prop]
	end)
	if not ok then
		classCache[prop] = { ok = false }
		return nil, false
	end

	local packed = packValue(value)
	if packed == nil then
		classCache[prop] = { ok = false }
		return nil, false
	end

	classCache[prop] = { ok = true, value = packed }
	return packed, true
end

local function isDefaultPackedProperty(className, prop, packed)
	local defaultPacked, hasDefault = getDefaultPackedProperty(className, prop)
	return hasDefault and packedValuesEqual(packed, defaultPacked)
end

local function captureProps(obj)
	local data = {}
	for _, prop in ipairs(getPropertyList(obj)) do
		local ok, value = pcall(function()
			return obj[prop]
		end)
		if ok then
			local packed = packValue(value)
			if packed ~= nil and not isDefaultPackedProperty(obj.ClassName, prop, packed) then
				data[prop] = packed
			end
		end
	end
	return data
end

function captureAllPackedProps(obj)
	local data = {}
	for _, prop in ipairs(getPropertyList(obj)) do
		local ok, value = pcall(function()
			return obj[prop]
		end)
		if ok then
			local packed = packValue(value)
			if packed ~= nil then
				data[prop] = packed
			end
		end
	end
	return data
end

local function applyProps(obj, props, skip)
	if typeof(props) ~= "table" then
		return
	end
	for prop, packed in pairs(props) do
		if not skip or not skip[prop] then
			local value = unpackValue(packed)
			if value ~= nil then
				pcall(function()
					obj[prop] = value
				end)
			end
		end
	end
end

local function applyDefaultPropsForSkipped(obj, className, props, skip)
	props = props or {}
	skip = skip or {}
	for _, prop in ipairs(getPropertyList(obj)) do
		if props[prop] == nil and not skip[prop] then
			local defaultPacked, hasDefault = getDefaultPackedProperty(className, prop)
			if hasDefault then
				local value = unpackValue(defaultPacked)
				if value ~= nil then
					pcall(function()
						obj[prop] = value
					end)
				end
			end
		end
	end
end

function shouldCaptureLightingChild(obj)
	return not obj:IsA("Script")
		and not obj:IsA("LocalScript")
		and not obj:IsA("ModuleScript")
end

function restoreReplayLighting()
	if not lightingRestoreState then
		return
	end

	for i = #(lightingRestoreState.CreatedChildren or {}), 1, -1 do
		local child = lightingRestoreState.CreatedChildren[i]
		if child then
			child:Destroy()
		end
	end

	applyProps(Lighting, lightingRestoreState.Props)

	for _, child in ipairs(lightingRestoreState.HiddenChildren or {}) do
		if child and child.Parent == nil then
			child.Parent = Lighting
		end
	end

	lightingRestoreState = nil
end

local VALUE_NIL = 0
local VALUE_NUMBER = 1
local VALUE_STRING = 2
local VALUE_FALSE = 3
local VALUE_TRUE = 4
