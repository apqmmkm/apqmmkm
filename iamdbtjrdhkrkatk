function loadSavedReplays()
	if not LoadReplaysFunction then
		Possessions = {}
		refreshReplayList()
		return
	end

	task.spawn(function()
		local ok, savedList = pcall(function()
			return LoadReplaysFunction:InvokeServer()
		end)
		if not ok or typeof(savedList) ~= "table" then
			return
		end

		Possessions = {}
		for _, saved in ipairs(savedList) do
			local dec = decodeSavedReplay(saved)
			if dec then
				table.insert(Possessions, dec)
			end
		end
		refreshReplayList()
	end)
end

function saveSession(session)
	if not SaveReplayFunction then
		ShareStatusLabel.Text = "익스플로러 버전은 서버 저장 없이 코드 버튼으로 내보내세요."
		return
	end

	if not session or session.IsSaved or session.IsSaving then
		return
	end

	session.IsSaving = true
	ShareStatusLabel.Text = "영구 저장 중..."
	refreshReplayList()

	task.spawn(function()
		local payload = encodeSessionForSave(session)
		if not payload then
			session.IsSaved = false
			session.IsSaving = false
			ShareStatusLabel.Text = "저장 실패: 압축에 실패했습니다."
			warn("[Replay] save failed: zstd compression failed")
			refreshReplayList()
			return
		end

		local okEncode, jsonString = pcall(function()
			return HttpService:JSONEncode(payload)
		end)

		if okEncode and jsonString then
			local exactByteSize = string.len(jsonString)
			payload.TotalBytes = exactByteSize
			session.TotalBytes = exactByteSize
		end

		local ok, saved, uniqueIdOrMsg = pcall(function()
			return SaveReplayFunction:InvokeServer(payload)
		end)

		if ok and saved then
			session.IsSaved = true
			session.IsSaving = false
			session.UniqueId = uniqueIdOrMsg
			ShareStatusLabel.Text = "영구 저장 완료."
			print("[Replay] save complete:", formatBytes(session.TotalBytes))
			refreshReplayList()
		else
			session.IsSaved = false
			session.IsSaving = false
			ShareStatusLabel.Text = "저장 실패: " .. tostring(uniqueIdOrMsg or saved)
			warn("[Replay] save failed:", uniqueIdOrMsg or saved)
			refreshReplayList()
		end
	end)
end

function cloneReplayState(state)
	local copy = {}
	for id, value in pairs(state or {}) do
		if type(value) == "table" then
			local valueCopy = {}
			for k, v in pairs(value) do
				valueCopy[k] = v
			end
			copy[id] = valueCopy
		else
			copy[id] = value
		end
	end
	return copy
end

function resetStateCache(session)
	session.StateCache = { [0] = {} }
	session.StateCacheOrder = {}
end

function rememberState(session, frameIndex, state)
	if not session.StateCache then
		resetStateCache(session)
	end
	if session.StateCache[frameIndex] then
		return
	end

	session.StateCache[frameIndex] = cloneReplayState(state)
	table.insert(session.StateCacheOrder, frameIndex)

	while #session.StateCacheOrder > STATE_CACHE_LIMIT do
		local victim = table.remove(session.StateCacheOrder, 1)
		session.StateCache[victim] = nil
	end
end

function getStateForFrame(session, frameIndex)
	frameIndex = math.clamp(math.floor(frameIndex), 1, #session.Frames)
	if not session.StateCache then
		resetStateCache(session)
	end

	if session.StateCache[frameIndex] then
		return session.StateCache[frameIndex]
	end

	local bestIndex = 0
	for cachedIndex in pairs(session.StateCache) do
		if cachedIndex <= frameIndex and cachedIndex > bestIndex then
			bestIndex = cachedIndex
		end
	end

	local state = cloneReplayState(session.StateCache[bestIndex] or {})
	for i = bestIndex + 1, frameIndex do
		if session.Frames[i] then
			local ok = deserializeBuffer(session.Frames[i], session.TrackedParts, state, session.StringArray)
			if not ok then
				return nil
			end
		end
	end

	rememberState(session, frameIndex, state)
	return session.StateCache[frameIndex]
end

SEEK_REBUILD_DISTANCE = REPLAY_FPS * 6
AUTO_REPLAY_REPOSITION_DISTANCE = 1500
AUTO_REPLAY_CAMERA_FORWARD_DISTANCE = 80

function clearTable(t)
	for k in pairs(t) do
		t[k] = nil
	end
end

function copyStateInto(target, source)
	clearTable(target)
	for id, value in pairs(source or {}) do
		target[id] = value
	end
end

function resetPlaybackCursor(session)
	session.PlaybackState = {}
	session.PlaybackFrame = 0
	session.NextStateOverlay = {}
	session.NextStateOverlayMeta = {}
	session.NextStateOverlayFrame = nil
	session.NextStateOverlayBaseFrame = nil
end

function getPlaybackStateForFrame(session, frameIndex)
	frameIndex = math.clamp(math.floor(frameIndex), 1, #session.Frames)

	if not session.PlaybackState then
		resetPlaybackCursor(session)
	end

	if frameIndex < session.PlaybackFrame or frameIndex - session.PlaybackFrame > SEEK_REBUILD_DISTANCE then
		local state = getStateForFrame(session, frameIndex)
		if not state then
			return nil
		end
		copyStateInto(session.PlaybackState, state)
		session.PlaybackFrame = frameIndex
		session.NextStateOverlayFrame = nil
		return session.PlaybackState
	end

	local previousFrame = session.PlaybackFrame

	for i = session.PlaybackFrame + 1, frameIndex do
		if session.Frames[i] then
			local ok = deserializeBuffer(session.Frames[i], session.TrackedParts, session.PlaybackState, session.StringArray)
			if not ok then
				return nil
			end
		end
	end

	session.PlaybackFrame = frameIndex
	if previousFrame ~= frameIndex then
		session.NextStateOverlayFrame = nil
	end

	return session.PlaybackState
end

function getNextStateOverlay(session, frameIndex, baseState)
	if session.NextStateOverlayFrame == frameIndex and session.NextStateOverlayBaseFrame == session.PlaybackFrame then
		return session.NextStateOverlay
	end

	local overlay = session.NextStateOverlay or {}
	clearTable(overlay)
	session.NextStateOverlay = overlay

	local meta = session.NextStateOverlayMeta or {}
	meta.__index = baseState
	session.NextStateOverlayMeta = meta
	setmetatable(overlay, meta)

	if session.Frames[frameIndex] then
		local ok = deserializeBuffer(session.Frames[frameIndex], session.TrackedParts, overlay, session.StringArray)
		if not ok then
			setmetatable(overlay, nil)
			return nil
		end
	end

	setmetatable(overlay, nil)
	session.NextStateOverlayFrame = frameIndex
	session.NextStateOverlayBaseFrame = session.PlaybackFrame
	return overlay
end

function overlayValue(baseState, overlay, id)
	local value = rawget(overlay, id)
	if value ~= nil then
		return value
	end
	return baseState[id]
end

function getReplayTargetPosition()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end

	local camera = workspace.CurrentCamera
	if camera then
		return camera.CFrame.Position + camera.CFrame.LookVector * AUTO_REPLAY_CAMERA_FORWARD_DISTANCE
	end

	return Vector3.new(0, 10, 0)
end

function getReplayAnchorPosition(session)
	local state = getStateForFrame(session, 1)
	if not state then
		return nil
	end

	local recorderRootId = tonumber(session.RecorderRootId)
	if recorderRootId then
		local value = state[recorderRootId]
		if value and value ~= false then
			return value[1].Position
		end
	end

	local minPos
	local maxPos
	for _, item in ipairs(getTrackedList(session)) do
		if item.kind == "BasePart" then
			local value = state[item.id]
			if value and value ~= false then
				local pos = value[1].Position
				if minPos then
					minPos = Vector3.new(math.min(minPos.X, pos.X), math.min(minPos.Y, pos.Y), math.min(minPos.Z, pos.Z))
					maxPos = Vector3.new(math.max(maxPos.X, pos.X), math.max(maxPos.Y, pos.Y), math.max(maxPos.Z, pos.Z))
				else
					minPos = pos
					maxPos = pos
				end
			end
		end
	end

	if minPos and maxPos then
		return (minPos + maxPos) * 0.5
	end

	return nil
end

function updateReplayPlaybackOffset(session)
	if not session then
		return
	end

	session.PlaybackOffset = CFrame.new()

	local anchor = getReplayAnchorPosition(session)
	local target = getReplayTargetPosition()
	if not anchor or not target then
		return
	end

	local delta = target - anchor
	if delta.Magnitude >= AUTO_REPLAY_REPOSITION_DISTANCE then
		session.PlaybackOffset = CFrame.new(delta)
	else
		session.PlaybackOffset = CFrame.new()
	end
end

function offsetReplayCFrame(cf)
	if currentSession and currentSession.PlaybackOffset then
		return currentSession.PlaybackOffset * cf
	end
	return cf
end

function updateRecorderRootId(session)
	if not session or session.RecorderRootId then
		return
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end

	if not session.OrigToId[root] then
		registerEntity(character or root)
	end

	session.RecorderRootId = session.OrigToId[root]
end

function rememberReplayParents(session)
	for _, item in ipairs(getTrackedList(session)) do
		local clone = item.clone
		if clone and clone.Parent then
			item.replayParent = clone.Parent
		end
	end
end

function getReplayParentForItem(item)
	if not item then
		return nil
	end
	if item.replayParent then
		return item.replayParent
	end

	local session = currentSession
	if not session then
		return nil
	end

	local data = getManifestData(session, item.id)
	if not isLightingManifestData(data) then
		return nil
	end

	local parentId = item.replayParentId or tonumber(data.ParentId)
	if parentId then
		local parent = session.LightingIdToInstance and session.LightingIdToInstance[parentId]
		if not parent and session.TrackedParts and session.TrackedParts[parentId] then
			parent = session.TrackedParts[parentId].clone
		end
		if parent then
			item.replayParent = parent
			return parent
		end
	end

	if data.ClassName ~= "Lighting" then
		item.replayParent = Lighting
		return Lighting
	end

	return nil
end

function setReplayObjectActive(item, active)
	local clone = item.clone
	if not clone then
		return
	end

	if active then
		if not clone.Parent then
			local parent = getReplayParentForItem(item)
			if parent then
				pcall(function()
					clone.Parent = parent
				end)
			end
		end
	else
		if clone.Parent then
			item.replayParent = item.replayParent or clone.Parent
			clone.Parent = nil
		end
	end
end

function applyFrame(floatFrame)
	if not currentSession then
		return
	end

	local idx1 = math.clamp(math.floor(floatFrame), 1, totalFrames)
	local idx2 = math.min(idx1 + 1, totalFrames)
	local alpha = floatFrame - idx1

	local state1 = getPlaybackStateForFrame(currentSession, idx1)
	if not state1 then
		return
	end

	local state2Overlay
	if idx2 ~= idx1 then
		state2Overlay = getNextStateOverlay(currentSession, idx2, state1)
		if not state2Overlay then
			return
		end
	end

	for _, item in ipairs(getTrackedList(currentSession)) do
		local id = item.id
		local c = item.clone
		local f1 = state1[id]
		local f2 = f1
		if state2Overlay then
			f2 = overlayValue(state1, state2Overlay, id)
		end

		if c and f1 ~= false and f1 ~= nil then
			if item.kind == "BasePart" then
				setReplayObjectActive(item, true)
				if f2 ~= false and f2 ~= nil then
					local cf = f1[1]:Lerp(f2[1], alpha)
					local size = f1[2]:Lerp(f2[2], alpha)
					local color = f1[3]:Lerp(f2[3], alpha)
					local trans = f1[4] + (f2[4] - f1[4]) * alpha

					c.CFrame = offsetReplayCFrame(cf)
					c.Color = color
					c.Transparency = trans
					if item.meshFallback and item.meshVisual then
						local baseSize = item.meshBaseSize or c.Size
						item.meshVisual.Scale = Vector3.new(safeDiv(size.X, baseSize.X), safeDiv(size.Y, baseSize.Y), safeDiv(size.Z, baseSize.Z))
					else
						c.Size = size
					end
				else
					c.CFrame = offsetReplayCFrame(f1[1])
					c.Color = f1[3]
					c.Transparency = f1[4]
					c.Size = f1[2]
				end
			elseif item.kind == "Decal" then
				local t1 = f1[2] or 0
				local l1 = f1[3] or 0
				local color1 = f1[4] or Color3.new(1, 1, 1)
				local texture1 = f1[1] or ""
				local t2, l2, color2 = t1, l1, color1
				if f2 ~= false and f2 ~= nil and type(f2) == "table" then
					t2 = f2[2] or t1
					l2 = f2[3] or l1
					color2 = f2[4] or color1
				end

				local t = t1 + (t2 - t1) * alpha
				local l = l1 + (l2 - l1) * alpha
				local color = color1:Lerp(color2, alpha)

				pcall(function() c.Texture = texture1 end)
				pcall(function() c.Color3 = color end)
				applyDecalTransparencyState(c, { t, l })
			elseif item.kind == "Sound" then
				local isPlaying1 = f1[1]
				local timePos1 = f1[2]
				local vol1 = f1[3]
				local timePos2 = (f2 ~= false and f2 ~= nil) and f2[2] or timePos1
				local vol2 = (f2 ~= false and f2 ~= nil) and f2[3] or vol1
				local vol = vol1 + (vol2 - vol1) * alpha
				local lerpedTimePos = timePos1 + (timePos2 - timePos1) * alpha

				c.Volume = vol
				if isPlaying1 and isPlaying and not isDraggingTimeline then
					if not c.IsPlaying then
						c:Play()
					end
					if math.abs(c.TimePosition - lerpedTimePos) > 0.15 then
						c.TimePosition = lerpedTimePos
					end
				else
					if c.IsPlaying then
						c:Stop()
					end
					c.TimePosition = lerpedTimePos
				end
			elseif item.kind == "Text" then
				c.Text = f1
			elseif item.kind == "Enabled" then
				c.Enabled = f1
			elseif item.kind == "Props" then
				setReplayObjectActive(item, true)
				applyProps(c, f1)
			end
		elseif c then
			if item.kind == "BasePart" then
				setReplayObjectActive(item, false)
			elseif item.kind == "Decal" then
				applyDecalTransparencyState(c, { 1, 1 })
			elseif item.kind == "Sound" then
				if c.IsPlaying then
					c:Stop()
				end
			elseif item.kind == "Text" then
				c.Text = ""
			elseif item.kind == "Enabled" then
				c.Enabled = false
			elseif item.kind == "Props" then
				if c ~= Lighting then
					setReplayObjectActive(item, false)
				end
			end
		end
	end

	local percent = (totalFrames > 1) and ((floatFrame - 1) / (totalFrames - 1)) or 0
	TimelineFill.Size = UDim2.new(math.clamp(percent, 0, 1), 0, 1, 0)
end

function stopAllReplaySounds()
	if not currentSession then
		return
	end
	for _, item in ipairs(getTrackedList(currentSession)) do
		if item.kind == "Sound" and item.clone and item.clone.IsPlaying then
			item.clone:Stop()
		end
	end
end

function togglePlayPause()
	if not isReplayMode then
		return
	end

	isPlaying = not isPlaying
	if isPlaying then
		if currentFrame >= totalFrames then
			currentFrame = 1
		end
		PlayPauseBtn.Text = "⏸ 일시정지"
		PlayPauseBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 80)
		applyFrame(currentFrame)
	else
		PlayPauseBtn.Text = "▶ 재생"
		PlayPauseBtn.BackgroundColor3 = Color3.fromRGB(80, 200, 80)
		stopAllReplaySounds()
	end
end

startReplay = function(session)
	if not session or #session.Frames == 0 then
		return
	end

	currentSession = session
	if session.IsLoadedReplay or not next(session.RootClones) then
		buildLoadedReplay(session)
	end

	resetStateCache(currentSession)
	resetPlaybackCursor(currentSession)
	buildReplayLighting(currentSession)
	resetStateCache(currentSession)
	resetPlaybackCursor(currentSession)
	updateReplayPlaybackOffset(currentSession)
	resetPlaybackCursor(currentSession)

	isReplayMode = true
	isPlaying = true
	totalFrames = #currentSession.Frames
	currentFrame = 1

	ReplayFolder.Parent = workspace
	for _, clone in pairs(currentSession.RootClones) do
		if clone then
			clone.Parent = ReplayFolder
		end
	end
	rememberReplayParents(currentSession)
	refreshReplayHumanoidAppearances(currentSession)

	hideLiveWorld()
	hideAllOtherGuis()
	applyFrame(currentFrame)

	MainToggleBtn.Visible = false
	ActionMenu.Visible = false
	PlaybackMenu.Visible = true
	PlayPauseBtn.Text = "⏸ 일시정지"
